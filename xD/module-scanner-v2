end

local function rebuildModuleList()
    for _, child in ipairs(ModuleList:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    moduleButtons = {}

    local searchText =
        string.lower(Search.Text)

    for _, module in ipairs(allModules) do
        local name =
            string.lower(module.Name)

        local path =
            string.lower(module:GetFullName())

        if searchText == "" or
            string.find(
                name,
                searchText,
                1,
                true
            ) or
            string.find(
                path,
                searchText,
                1,
                true
            ) then

            createModuleButton(module)
        end
    end

    task.defer(function()
        ModuleList.CanvasSize =
            UDim2.fromOffset(
                0,
                ModuleLayout.AbsoluteContentSize.Y + 8
            )
    end)
end

local function scanModules()
    allModules = {}

    for _, descendant in ipairs(
        ReplicatedStorage:GetDescendants()
    ) do
        if descendant:IsA("ModuleScript") then
            table.insert(
                allModules,
                descendant
            )
        end
    end

    table.sort(
        allModules,
        function(a, b)
            return a:GetFullName() <
                b:GetFullName()
        end
    )

    rebuildModuleList()

    Status.Text =
        "Found " ..
        tostring(#allModules) ..
        " ModuleScripts"
end

local function executeModule(module)
    if not module then
        return
    end

    if executedModules[module] then
        clearOutput()

        addLine(
            "This module was already executed.",
            0
        )

        addLine(
            "Execution blocked for safety.",
            1
        )

        Status.Text = "Execution blocked"
        return
    end

    clearOutput()

    addLine("EXECUTING MODULE", 0)
    addLine(module:GetFullName(), 1)
    addLine("", 0)

    local success, result = pcall(function()
        return require(module)
    end)

    executedModules[module] = true

    if not success then
        addLine("ERROR", 0)
        addLine(
            safeToString(result),
            1
        )

        Status.Text = "Module execution failed"
        return
    end

    addLine(
        "Execution completed.",
        0
    )

    addLine(
        "Returned type: " ..
        valueType(result),
        1
    )

    addLine("", 0)
    addLine(
        "Returned data is not automatically executed.",
        0
    )

    Status.Text = "Module executed once"
end

