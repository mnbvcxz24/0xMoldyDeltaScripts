local function clearOutput()
    for _, child in ipairs(Output:GetChildren()) do
        if child:IsA("TextLabel") then
            child:Destroy()
        end
    end

    Output.CanvasSize = UDim2.new()
end

local function addLine(text, depth)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -8, 0, 15)
    label.BackgroundTransparency = 1
    label.Text = string.rep("  ", depth or 0) .. tostring(text)
    label.TextColor3 = Color3.fromRGB(210, 210, 220)
    label.TextSize = 9
    label.Font = Enum.Font.Code
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextYAlignment = Enum.TextYAlignment.Center
    label.TextWrapped = false
    label.TextTruncate = Enum.TextTruncate.AtEnd
    label.Parent = Output

    task.defer(function()
        Output.CanvasSize = UDim2.fromOffset(
            0,
            OutputLayout.AbsoluteContentSize.Y + 8
        )
    end)

    return label
end

local function safeToString(value)
    local ok, result = pcall(function()
        return tostring(value)
    end)

    if ok then
        return result
    end

    return "<tostring failed>"
end

local function valueType(value)
    local ok, result = pcall(function()
        return typeof(value)
    end)

    if ok then
        return result
    end

    return type(value)
end

local function inspectInstance(module)
    clearOutput()

    if not module then
        addLine("No module selected.", 0)
        return
    end

    SelectedLabel.Text =
        "Selected: " ..
        module:GetFullName()

    addLine("MODULE", 0)
    addLine(module.Name, 1)
    addLine(
        "Path: " ..
        module:GetFullName(),
        1
    )
    addLine(
        "Class: " ..
        module.ClassName,
        1
    )

    addLine("", 0)
    addLine("READ-ONLY INFORMATION", 0)

    local attributes = module:GetAttributes()

    if next(attributes) then
        addLine("ATTRIBUTES", 1)

        local keys = {}

        for key in pairs(attributes) do
            table.insert(keys, key)
        end

        table.sort(keys)

        for _, key in ipairs(keys) do
            addLine(
                tostring(key) ..
                " = " ..
                safeToString(attributes[key]),
                2
            )
        end
    else
        addLine("No attributes", 1)
    end

    local children = module:GetChildren()

    addLine("", 0)
    addLine(
        "CHILDREN: " ..
        tostring(#children),
        0
    )

    for _, child in ipairs(children) do
        addLine(
            child.Name ..
            " [" ..
            child.ClassName ..
            "]",
            1
        )
    end

    Status.Text = "Read-only inspection complete"
end

local function inspectSelected()
    if not selectedModule then
        clearOutput()
        addLine("Select a ModuleScript first.", 0)
        return
    end

    inspectInstance(selectedModule)
end

