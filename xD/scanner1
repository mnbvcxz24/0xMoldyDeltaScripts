local function ClearOutput()
    for _, child in ipairs(Output:GetChildren()) do
        if child:IsA("TextLabel") then
            child:Destroy()
        end
    end

    Output.CanvasSize = UDim2.new(0, 0, 0, 0)
end

local function ScanPlot()
    ClearOutput()

    AddDebug("=== RAP PLOT SCANNER ===")
    AddDebug("Player: " .. player.Name)

    local plots = workspace:FindFirstChild("Plots")

    if not plots then
        AddDebug("[ERROR] Workspace.Plots not found")
        return
    end

    AddDebug("Plots found: " .. tostring(#plots:GetChildren()))
    AddDebug("")

    local myPlot = nil

    for _, plot in ipairs(plots:GetChildren()) do
        if plot:IsA("Model") then
            AddDebug("[PLOT] " .. plot.Name)

            local data = plot:FindFirstChild("Data")

            if data then
                local owner = data:FindFirstChild("Owner")

                if owner then
                    AddDebug(
                        "  Owner: " ..
                        tostring(owner.Value)
                    )

                    if tostring(owner.Value) == player.Name then
                        myPlot = plot
                        AddDebug("  >>> YOUR PLOT <<<")
                    end
                else
                    AddDebug("  Owner: not found")
                end
            else
                AddDebug("  Data: not found")
            end
        end
    end

    AddDebug("")

    if not myPlot then
        AddDebug("[ERROR] Your plot was not found")
        return
    end

    AddDebug("=== YOUR PLOT ===")
    AddDebug("Plot: " .. myPlot:GetFullName())

    local baseplate = myPlot:FindFirstChild("Baseplate")

    if not baseplate then
        AddDebug("[ERROR] Baseplate not found")
        return
    end

    AddDebug("")
    AddDebug("=== BASEPLATE ===")
    AddDebug("Class: " .. baseplate.ClassName)
    AddDebug("Position:")
    AddDebug(tostring(baseplate.Position))

    AddDebug("")
    AddDebug("Size:")
    AddDebug(tostring(baseplate.Size))

    AddDebug("")
    AddDebug("CFrame:")
    AddDebug(tostring(baseplate.CFrame))

    AddDebug("")
    AddDebug("=== OTHER PARTS ===")

    for _, child in ipairs(myPlot:GetChildren()) do
        AddDebug(
            child.Name ..
            " [" ..
            child.ClassName ..
            "]"
        )
    end

    AddDebug("")
    AddDebug("Scan complete.")
end

local function ScanPlot2()
    ClearOutput()

    AddDebug("=== PLOT POSITION SCANNER ===")

    local plots = workspace:FindFirstChild("Plots")

    if not plots then
        AddDebug("[ERROR] Workspace.Plots not found")
        return
    end

    local myPlot

    for _, plot in ipairs(plots:GetChildren()) do
        local data = plot:FindFirstChild("Data")

        if data then
            local owner = data:FindFirstChild("Owner")

            if owner and tostring(owner.Value) == player.Name then
                myPlot = plot
                break
            end
        end
    end

    if not myPlot then
        AddDebug("[ERROR] Your plot was not found")
        return
    end

    AddDebug("Plot: " .. myPlot:GetFullName())
    AddDebug("")

    local function ScanContainer(container)
        AddDebug("[" .. container.Name .. "]")

        for _, obj in ipairs(container:GetDescendants()) do
            if obj:IsA("BasePart") then
                AddDebug(
                    obj:GetFullName() ..
                    " | Position: " ..
                    tostring(obj.Position) ..
                    " | Size: " ..
                    tostring(obj.Size)
                )
            elseif obj:IsA("SpawnLocation") then
                AddDebug(
                    obj:GetFullName() ..
                    " | Spawn: " ..
                    tostring(obj.Position)
                )
            elseif obj:IsA("Attachment") then
                AddDebug(
                    obj:GetFullName() ..
                    " | Attachment: " ..
                    tostring(obj.WorldPosition)
                )
            end
        end
    end

    local data = myPlot:FindFirstChild("Data")
    local eggs = myPlot:FindFirstChild("Eggs")
    local nests = myPlot:FindFirstChild("Nests")
    local pets = myPlot:FindFirstChild("Pets")
    local hatch = myPlot:FindFirstChild("HatchUpgrade")

    if data then
        ScanContainer(data)
    end

    if nests then
        ScanContainer(nests)
    end

    if hatch then
        ScanContainer(hatch)
    end

    if eggs then
        ScanContainer(eggs)
    end

    if pets then
        ScanContainer(pets)
    end

    AddDebug("")
    AddDebug("=== COMPLETE ===")
end

