local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Destroy previous copy
local oldGui = playerGui:FindFirstChild("EggArrivalTest")
if oldGui then
    oldGui:Destroy()
end

local gui = Instance.new("ScreenGui")
gui.Name = "EggArrivalTest"
gui.ResetOnSpawn = false
gui.Parent = playerGui

local frame = Instance.new("Frame")
frame.Size = UDim2.fromOffset(350, 350)
frame.Position = UDim2.new(1, -270, 1, -225)
frame.BackgroundColor3 = Color3.fromRGB(30, 30, 36)
frame.BorderSizePixel = 0
frame.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent = frame

-- Drag support
local dragging = false
local dragStart = nil
local startPosition = nil

frame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        dragging = true
        dragStart = input.Position
        startPosition = frame.Position
    end
end)

frame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        dragging = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not dragging then
        return
    end

    if input.UserInputType ~= Enum.UserInputType.MouseMovement
        and input.UserInputType ~= Enum.UserInputType.Touch then
        return
    end

    local delta = input.Position - dragStart

    frame.Position = UDim2.new(
        startPosition.X.Scale,
        startPosition.X.Offset + delta.X,
        startPosition.Y.Scale,
        startPosition.Y.Offset + delta.Y
    )
end)

local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, -20, 0, 145)
status.Position = UDim2.fromOffset(10, 8)
status.BackgroundTransparency = 1
status.Text = "Ready"
status.TextColor3 = Color3.fromRGB(210, 210, 220)
status.TextSize =8
status.Font = Enum.Font.Gotham
status.TextXAlignment = Enum.TextXAlignment.Left
status.TextYAlignment = Enum.TextYAlignment.Top
status.TextWrapped = true
status.Parent = frame

local button = Instance.new("TextButton")
button.Size = UDim2.new(1, -20, 0, 42)
button.Position = UDim2.new(0, 10, 1, -52)
button.BackgroundColor3 = Color3.fromRGB(55, 55, 65)
button.Text = "Test Egg Arrival"
button.TextColor3 = Color3.fromRGB(235, 235, 240)
button.TextSize =8
button.Font = Enum.Font.GothamBold
button.AutoButtonColor = true
button.Parent = frame

local buttonCorner = Instance.new("UICorner")
buttonCorner.CornerRadius = UDim.new(0, 6)
buttonCorner.Parent = button

button.MouseButton1Click:Connect(function()
    status.Text = "Searching..."

    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if not root then
        status.Text = "Character not ready"
        return
    end

    local replicatedStorage = game:GetService("ReplicatedStorage")
    local serverData = replicatedStorage:FindFirstChild("ServerData")
    local activeEggs = serverData and serverData:FindFirstChild("ActiveEggs")

    if not activeEggs then
        status.Text = "ActiveEggs not found"
        return
    end

    local nearestEgg = nil
    local nearestDistance = math.huge
    local nearestPosition = nil

    for _, egg in ipairs(activeEggs:GetChildren()) do
        local position = nil

        if egg:IsA("BasePart") then
            position = egg.Position
        else
            local attrPosition = egg:GetAttribute("Position")

            if typeof(attrPosition) == "Vector3" then
                position = attrPosition
            end
        end

        if position then
            local distance = (root.Position - position).Magnitude

            if distance < nearestDistance then
                nearestDistance = distance
                nearestEgg = egg
                nearestPosition = position
            end
        end
    end

    if not nearestEgg then
        status.Text = "No active egg found"
        return
    end

    -- ActiveEggs child name = UUID
    local eggUUID = nearestEgg.Name

    -- Egg attribute = egg name
    local eggName = nearestEgg:GetAttribute("Egg")

    if eggName == nil then
        eggName = "Unknown"
    end

local attributes = nearestEgg:GetAttributes()

local attributeText = ""

for name, value in pairs(attributes) do
    attributeText = attributeText
        .. tostring(name)
        .. " = "
        .. tostring(value)
        .. "\n"
end

if attributeText == "" then
    attributeText = "No attributes found"
end

status.Text =
    "Egg: " .. tostring(eggName) ..
    "\nDistance: " .. string.format("%.1f", nearestDistance) ..
    "\nUUID: " .. tostring(eggUUID) ..
    "\n\nAttributes:\n" ..
    attributeText
end)
