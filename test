local function getEggs()
    local plots=workspace:FindFirstChild("Plots")
    local plot=plots and plots:FindFirstChild("Plot")
    local eggs=plot and plot:FindFirstChild("Eggs")
    return eggs
end

local function getRoot()
    local character=player.Character
    if not character then return nil end
    return character:FindFirstChild("HumanoidRootPart")
end

local function getHatchPrompt(egg)
    local handle=egg:FindFirstChild("Handle")
    if not handle then return nil,nil end

    local hatch=handle:FindFirstChild("Hatch")
    if not hatch then return nil,nil end

    local prompt=hatch:FindFirstChildOfClass("ProximityPrompt")
    return hatch,prompt
end

local function getNearestEgg()
    local root=getRoot()
    local eggs=getEggs()

    if not root or not eggs then
        return nil
    end

    local nearest=nil
    local nearestDistance=math.huge

    for _,egg in ipairs(eggs:GetChildren()) do
        local handle=egg:FindFirstChild("Handle")

        if handle then
            local part

            if handle:IsA("BasePart") then
                part=handle
            else
                part=handle:FindFirstChildWhichIsA("BasePart",true)
            end

            if part then
                local distance=(root.Position-part.Position).Magnitude

                if distance<nearestDistance then
                    nearestDistance=distance
                    nearest=egg
                end
            end
        end
    end

    return nearest,nearestDistance
end

local function updateInfo()
    local egg,distance=getNearestEgg()

    if not egg then
        Info.Text="No egg found."
        return
    end

    local hatch,prompt=getHatchPrompt(egg)

    if not hatch then
        Info.Text="Egg: "..egg.Name.."\nHandle.Hatch: NOT FOUND"
        return
    end

    local available=hatch:GetAttribute("HatchPromptAvailable")

    Info.Text=
        "Egg: "..egg.Name..
        "\nDistance: "..string.format("%.2f",distance)..
        "\nHatchPromptAvailable: "..tostring(available)..
        "\nPrompt: "..(prompt and "FOUND" or "NOT FOUND")..
        "\nEnabled: "..(prompt and tostring(prompt.Enabled) or "N/A")..
        "\nHoldDuration: "..(prompt and tostring(prompt.HoldDuration) or "N/A")..
        "\nMaxDistance: "..(prompt and tostring(prompt.MaxActivationDistance) or "N/A")
end

Test.MouseButton1Click:Connect(function()
    local egg,distance=getNearestEgg()

    if not egg then
        Info.Text="No egg found."
        return
    end

    local hatch,prompt=getHatchPrompt(egg)

    if not hatch or not prompt then
        Info.Text="No Hatch ProximityPrompt found."
        return
    end

    local available=hatch:GetAttribute("HatchPromptAvailable")

    Info.Text=
        "Testing: "..egg.Name..
        "\nDistance: "..string.format("%.2f",distance)..
        "\nHatchPromptAvailable: "..tostring(available)..
        "\nPrompt Enabled: "..tostring(prompt.Enabled)

    if available~=true then
        Info.Text=Info.Text.."\n\nNOT READY / NOT AVAILABLE"
        return
    end

    if not prompt.Enabled then
        Info.Text=Info.Text.."\n\nPrompt is disabled."
        return
    end

    Info.Text=Info.Text.."\n\nStarting prompt..."

    pcall(function()
        prompt:InputHoldBegin()
    end)

    task.wait(math.max(prompt.HoldDuration,0.1))

    pcall(function()
        prompt:InputHoldEnd()
    end)

    task.wait(1)
    updateInfo()
end)

