task.spawn(function()
    while Gui.Parent do
        for egg,button in pairs(eggButtons) do
            if egg.Parent then
                local root=getRoot()
                local part=getEggPart(egg)
                local hatch,prompt=getHatch(egg)
                local available=hatch and hatch:GetAttribute("HatchPromptAvailable")
                local distance=root and part and (root.Position-part.Position).Magnitude

                local statusLabel=button:FindFirstChildWhichIsA("TextLabel",true)

                if statusLabel then
                    local labels=button:GetChildren()
                    local lastLabel=labels[#labels]

                    for _,child in ipairs(labels) do
                        if child:IsA("TextLabel") and child.Position.Y.Offset>=35 then
                            statusLabel=child
                        end
                    end

                    if distance and prompt then
                        statusLabel.Text="Available="..safeString(available).." | Dist "..string.format("%.1f",distance).." / "..string.format("%.1f",prompt.MaxActivationDistance)
                    elseif distance then
                        statusLabel.Text="Available="..safeString(available).." | Dist "..string.format("%.1f",distance)
                    else
                        statusLabel.Text="Available="..safeString(available)
                    end
                end
            end
        end

        task.wait(0.5)
    end
end)

local dragging=false
local dragStart
local startPosition

Title.InputBegan:Connect(function(input)
    if input.UserInputType==Enum.UserInputType.MouseButton1 then
        dragging=true
        dragStart=input.Position
        startPosition=Main.Position
    end
end)

Title.InputEnded:Connect(function(input)
    if input.UserInputType==Enum.UserInputType.MouseButton1 then
        dragging=false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType==Enum.UserInputType.MouseMovement then
        local delta=input.Position-dragStart

        Main.Position=UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset+delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset+delta.Y
        )
    end
end)

