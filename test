local function safeString(value)
    local ok,result=pcall(function()
        return tostring(value)
    end)
    return ok and result or "<error>"
end

local function getRoot()
    local character=player.Character
    if not character then return nil end
    return character:FindFirstChild("HumanoidRootPart")
end

local function findMyPlot()
    local plots=workspace:FindFirstChild("Plots")
    if not plots then return nil end

    for _,plot in ipairs(plots:GetChildren()) do
        local data=plot:FindFirstChild("Data")
        local owner=data and data:FindFirstChild("Owner")

        if owner then
            local ownerValue=owner.Value

            if ownerValue==player or ownerValue==player.Name or ownerValue==player.DisplayName then
                return plot
            end

            if tostring(ownerValue)==tostring(player.Name) then
                return plot
            end
        end
    end

    return nil
end

local function getEggs()
    local plot=findMyPlot()
    if not plot then return nil end
    return plot:FindFirstChild("Eggs")
end

local function getEggPart(egg)
    local handle=egg:FindFirstChild("Handle")

    if not handle then
        return nil
    end

    if handle:IsA("BasePart") then
        return handle
    end

    return handle:FindFirstChildWhichIsA("BasePart",true)
end

local function getHatch(egg)
    local handle=egg:FindFirstChild("Handle")
    if not handle then return nil,nil end

    local hatch=handle:FindFirstChild("Hatch")
    if not hatch then return nil,nil end

    local prompt=hatch:FindFirstChildOfClass("ProximityPrompt")

    return hatch,prompt
end

local function clearDetails()
    for _,child in ipairs(Details:GetChildren()) do
        if child:IsA("TextLabel") or child:IsA("TextButton") then
            child:Destroy()
        end
    end

    Details.CanvasSize=UDim2.new()
end

local function addDetail(text,color,bold)
    local label=Instance.new("TextLabel")
    label.Size=UDim2.new(1,-10,0,18)
    label.BackgroundTransparency=1
    label.Text=text
    label.TextColor3=color or Color3.fromRGB(215,215,225)
    label.TextSize=7
    label.Font=bold and Enum.Font.GothamBold or Enum.Font.Code
    label.TextXAlignment=Enum.TextXAlignment.Left
    label.TextTruncate=Enum.TextTruncate.AtEnd
    label.Parent=Details
    return label
end

local function inspectEgg(egg)
    if not egg or not egg.Parent then
        return
    end

    selectedEgg=egg
    clearDetails()

    local root=getRoot()
    local part=getEggPart(egg)
    local hatch,prompt=getHatch(egg)

    local eggKey=egg:GetAttribute("EggKey")
    local available=hatch and hatch:GetAttribute("HatchPromptAvailable")
    local distance=part and root and (root.Position-part.Position).Magnitude

    addDetail("EGG",Color3.fromRGB(100,190,125),true)
    addDetail("Name: "..egg.Name)
    addDetail("Class: "..egg.ClassName)
    addDetail("EggKey: "..safeString(eggKey))
    addDetail("Distance: "..(distance and string.format("%.2f",distance) or "N/A"))

    addDetail("HATCH",Color3.fromRGB(100,190,125),true)
    addDetail("Hatch: "..(hatch and "FOUND" or "NOT FOUND"))
    addDetail("Prompt: "..(prompt and "FOUND" or "NOT FOUND"))
    addDetail("HatchPromptAvailable: "..safeString(available))

    if prompt then
        addDetail("Enabled: "..safeString(prompt.Enabled))
        addDetail("MaxActivationDistance: "..safeString(prompt.MaxActivationDistance))

        if distance then
            addDetail("Within Max Distance: "..tostring(distance<=prompt.MaxActivationDistance))
        end
    end

    addDetail("ATTRIBUTES",Color3.fromRGB(100,190,125),true)

    local attributes=egg:GetAttributes()
    local names={}

    for name in pairs(attributes) do
        table.insert(names,name)
    end

    table.sort(names)

    if #names==0 then
        addDetail("<none>")
    else
        for _,name in ipairs(names) do
            addDetail(name.." = "..safeString(attributes[name]).." ["..typeof(attributes[name]).."]")
        end
    end

    task.defer(function()
        Details.CanvasSize=UDim2.fromOffset(0,Details.Layout.AbsoluteContentSize.Y+10)
    end)

    Status.Text="Selected: "..egg.Name
end

local function createEggButton(egg,index)
    local old=eggButtons[egg]

    if old then
        old:Destroy()
    end

    local button=Instance.new("TextButton")
    button.Size=UDim2.new(1,-8,0,58)
    button.BackgroundColor3=egg==selectedEgg and Color3.fromRGB(55,85,65) or Color3.fromRGB(32,32,39)
    button.BorderSizePixel=0
    button.Text=""
    button.AutoButtonColor=false
    button.Parent=List

    local corner=Instance.new("UICorner")
    corner.CornerRadius=UDim.new(0,4)
    corner.Parent=button

    local name=Instance.new("TextLabel")
    name.Size=UDim2.new(1,-10,0,18)
    name.Position=UDim2.fromOffset(5,3)
    name.BackgroundTransparency=1
    name.Text=tostring(index)..". "..egg.Name
    name.TextColor3=Color3.fromRGB(230,230,235)
    name.TextSize=8
    name.Font=Enum.Font.GothamBold
    name.TextXAlignment=Enum.TextXAlignment.Left
    name.TextTruncate=Enum.TextTruncate.AtEnd
    name.Parent=button

    local key=Instance.new("TextLabel")
    key.Size=UDim2.new(1,-10,0,17)
    key.Position=UDim2.fromOffset(5,21)
    key.BackgroundTransparency=1
    key.Text="Key: "..safeString(egg:GetAttribute("EggKey"))
    key.TextColor3=Color3.fromRGB(150,150,160)
    key.TextSize=6
    key.Font=Enum.Font.Code
    key.TextXAlignment=Enum.TextXAlignment.Left
    key.TextTruncate=Enum.TextTruncate.AtEnd
    key.Parent=button

    local status=Instance.new("TextLabel")
    status.Size=UDim2.new(1,-10,0,15)
    status.Position=UDim2.fromOffset(5,38)
    status.BackgroundTransparency=1
    status.TextColor3=Color3.fromRGB(130,130,140)
    status.TextSize=6
    status.Font=Enum.Font.Code
    status.TextXAlignment=Enum.TextXAlignment.Left
    status.TextTruncate=Enum.TextTruncate.AtEnd
    status.Parent=button

    local function update()
        if not egg.Parent then
            status.Text="REMOVED"
            return
        end

        local root=getRoot()
        local part=getEggPart(egg)
        local hatch,prompt=getHatch(egg)
        local available=hatch and hatch:GetAttribute("HatchPromptAvailable")

        local distance=root and part and (root.Position-part.Position).Magnitude

        local rangeText="Range N/A"

        if distance and prompt then
            rangeText=string.format("Dist %.1f / Max %.1f",distance,prompt.MaxActivationDistance)
        elseif distance then
            rangeText=string.format("Dist %.1f",distance)
        end

        status.Text="Available="..safeString(available).." | "..rangeText
    end

    eggButtons[egg]=button

    button.MouseButton1Click:Connect(function()
        for _,other in pairs(eggButtons) do
            if other.Parent then
                other.BackgroundColor3=Color3.fromRGB(32,32,39)
            end
        end

        button.BackgroundColor3=Color3.fromRGB(55,85,65)
        inspectEgg(egg)
    end)

    update()

    return button
end

local function refreshEggs()
    local eggs=getEggs()

    if not eggs then
        Status.Text="My plot / Eggs folder not found."
        return
    end

    for _,child in ipairs(List:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    eggButtons={}
    eggsData={}

    local children=eggs:GetChildren()

    table.sort(children,function(a,b)
        return a.Name:lower()<b.Name:lower()
    end)

    for index,egg in ipairs(children) do
        local eggKey=egg:GetAttribute("EggKey")

        if eggKey then
            table.insert(eggsData,{
                Egg=egg,
                EggKey=tostring(eggKey)
            })

            createEggButton(egg,index)
        end
    end

    task.defer(function()
        List.CanvasSize=UDim2.fromOffset(0,Layout.AbsoluteContentSize.Y+10)
    end)

    Status.Text="Found "..tostring(#eggsData).." eggs"

    if selectedEgg and selectedEgg.Parent then
        inspectEgg(selectedEgg)
    else
        selectedEgg=nil
        clearDetails()
    end
end

local function hatchSelected()
    local egg=selectedEgg

    if not egg or not egg.Parent then
        Status.Text="Select an egg first."
        return
    end

    local eggKey=egg:GetAttribute("EggKey")

    if not eggKey then
        Status.Text="Selected egg has no EggKey."
        return
    end

    local HatchEvent=ReplicatedStorage:FindFirstChild("Remotes")

    if not HatchEvent then
        Status.Text="Remotes not found."
        return
    end

    local Game=HatchEvent:FindFirstChild("Game")

    if not Game then
        Status.Text="Remotes.Game not found."
        return
    end

    local Hatch=Game:FindFirstChild("Hatch")

    if not Hatch then
        Status.Text="Hatch remote not found."
        return
    end

    Status.Text="Firing Hatch: "..tostring(eggKey)

    local success,err=pcall(function()
        Hatch:FireServer({
            EggKey=tostring(eggKey)
        })
    end)

    if success then
        Status.Text="Hatch fired: "..egg.Name
    else
        Status.Text="Hatch error: "..safeString(err)
    end

    task.wait(0.5)
    refreshEggs()
end

