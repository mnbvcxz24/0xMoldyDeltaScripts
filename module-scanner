local function createTreeNode(instance,depth)
    local searchText=string.lower(Search.Text)

    if searchText~="" and
        not hasMatchingDescendant(instance,searchText) then
        return
    end

    local children=instance:GetChildren()

    table.sort(children,function(a,b)
        return a.Name<b.Name
    end)

    local hasChildren=#children>0

    local button=Instance.new("TextButton")
    button.Size=UDim2.new(1,-6,0,22)
    button.BackgroundTransparency=1
    button.BorderSizePixel=0
    button.TextColor3=Color3.fromRGB(215,215,225)
    button.TextSize=9
    button.Font=Enum.Font.Gotham
    button.TextXAlignment=Enum.TextXAlignment.Left
    button.TextTruncate=Enum.TextTruncate.AtEnd
    button.Active=true
    button.ZIndex=5
    button.Parent=Tree

    local prefix=""
    for _=1,depth do
        prefix=prefix.."    "
    end

    local arrow=""

    if hasChildren then
        if expanded[instance] then
            arrow="▼ "
        else
            arrow="▶ "
        end
    else
        arrow="  "
    end

    button.Text=
        prefix..
        arrow..
        getIcon(instance)..
        " "..
        instance.Name

    if instance:IsA("ModuleScript") then
        button.TextColor3=Color3.fromRGB(180,220,190)
    elseif instance:IsA("Folder") then
        button.TextColor3=Color3.fromRGB(220,210,170)
    elseif instance:IsA("BasePart") then
        button.TextColor3=Color3.fromRGB(190,205,225)
    elseif instance:IsA("Tool") then
        button.TextColor3=Color3.fromRGB(225,190,150)
    end

    local padding=Instance.new("UIPadding")
    padding.PaddingLeft=UDim.new(0,4)
    padding.Parent=button

    nodeButtons[instance]=button

    button.MouseButton1Click:Connect(function()
        if hasChildren then
            expanded[instance]=not expanded[instance]
            rebuildTree()
        end

        for _,item in pairs(nodeButtons) do
            item.BackgroundColor3=Color3.fromRGB(27,27,33)
        end

        local currentButton=nodeButtons[instance]

        if currentButton then
            currentButton.BackgroundColor3=Color3.fromRGB(55,85,65)
        end

        inspectInstance(instance)
    end)

    if expanded[instance] then
        for _,child in ipairs(children) do
            createTreeNode(child,depth+1)
        end
    end
end

rebuildTree=function()
