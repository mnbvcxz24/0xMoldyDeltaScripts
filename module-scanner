local function addLine(text, depth)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -8, 0, 15)
    label.BackgroundTransparency = 1
    label.Text = string.rep("  ", depth or 0) .. tostring(text)
    label.TextColor3 = Color3.fromRGB(210, 210, 220)
    label.TextSize = 9
    label.Font = Enum.Font.Code
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextYAlignment = Enum.TextYAlignment.Center
    label.TextWrapped = false
    label.TextTruncate = Enum.TextTruncate.AtEnd
    label.Parent = Output

    updateOutputCanvas()

    return label
end

local function inspectValue(value, depth, visited, keyName)
    if depth > 12 then
        addLine(
            tostring(keyName or "") .. " = <max depth>",
            depth
        )
        return
    end

    local luaType = type(value)
    local robloxType = valueType(value)

    if luaType == "table" then
        if visited[value] then
            addLine(
                tostring(keyName or "") .. " = <recursive table>",
                depth
            )
            return
        end

        visited[value] = true

        local prefix = ""

        if keyName ~= nil then
            prefix = tostring(keyName) .. " = "
        end

        addLine(prefix .. "{", depth)

        local entries = {}

        local ok = pcall(function()
            for key, childValue in pairs(value) do
                table.insert(entries, {
                    key = key,
                    value = childValue
                })
            end
        end)

        if not ok then
            addLine(
                "<unable to enumerate table>",
                depth + 1
            )
        else
            table.sort(entries, function(a, b)
                return safeToString(a.key) < safeToString(b.key)
            end)

            for _, entry in ipairs(entries) do
                inspectValue(
                    entry.value,
                    depth + 1,
                    visited,
                    entry.key
                )
            end
        end

        addLine("}", depth)

        return
    end

    if luaType == "function" then
        addLine(
            tostring(keyName or "function") .. " = <function>",
            depth
        )
        return
    end

    if luaType == "thread" then
        addLine(
            tostring(keyName or "thread") .. " = <thread>",
            depth
        )
        return
    end

    if luaType == "userdata" then
        addLine(
            tostring(keyName or "userdata") ..
            " = <userdata> [" ..
            robloxType ..
            "]",
            depth
        )
        return
    end

    local prefix = ""

    if keyName ~= nil then
        prefix = tostring(keyName) .. " = "
    end

    addLine(
        prefix ..
        safeToString(value) ..
        " [" ..
        robloxType ..
        "]",
        depth
    )
end

local function inspectInstance(instance)
    clearOutput()

    if not instance then
        SelectedLabel.Text = "Selected: --"
        addLine("Nothing selected.", 0)
        return
    end

    selectedInstance = instance

    SelectedLabel.Text =
        "Selected: " ..
        safeToString(instance.Name)

    addLine("INSTANCE", 0)
    addLine(instance.Name, 1)

    addLine(
        "Path: " ..
        instance:GetFullName(),
        1
    )

    addLine(
        "Class: " ..
        instance.ClassName,
        1
    )

    local attributes = instance:GetAttributes()

    if next(attributes) then
        addLine("", 0)
        addLine("ATTRIBUTES", 0)

        local keys = {}

        for key in pairs(attributes) do
            table.insert(keys, key)
        end

        table.sort(keys)

        for _, key in ipairs(keys) do
            addLine(
                tostring(key) ..
                " = " ..
                safeToString(attributes[key]),
                1
            )
        end
    end

    if instance:IsA("ModuleScript") then
        addLine("", 0)
        addLine("MODULE", 0)
        addLine(
            "Press REQUIRE to inspect the returned value.",
            1
        )
    elseif instance:IsA("ValueBase") then
        addLine("", 0)
        addLine("VALUE", 0)
        addLine(
            safeToString(instance.Value) ..
            " [" ..
            valueType(instance.Value) ..
            "]",
            1
        )
    end

    local children = instance:GetChildren()

    if #children > 0 then
        addLine("", 0)
        addLine(
            "CHILDREN (" ..
            tostring(#children) ..
            ")",
            0
        )

        table.sort(children, function(a, b)
            return a.Name < b.Name
        end)

        for _, child in ipairs(children) do
            addLine(
                child.Name ..
                " [" ..
                child.ClassName ..
                "]",
                1
            )
        end
    end

    Status.Text =
        "Selected: " ..
        instance:GetFullName()
end

local function requireModule(module)
    clearOutput()

    if not module or not module:IsA("ModuleScript") then
        addLine("Selected instance is not a ModuleScript.", 0)
        Status.Text = "Require unavailable"
        return
    end

    SelectedLabel.Text =
        "Selected: " ..
        module.Name

    addLine("MODULE", 0)
    addLine(module.Name, 1)

    addLine(
        "Path: " ..
        module:GetFullName(),
        1
    )

    addLine(
        "Class: " ..
        module.ClassName,
        1
    )

    local attributes = module:GetAttributes()

    if next(attributes) then
        addLine("", 0)
        addLine("ATTRIBUTES", 0)

        local keys = {}

        for key in pairs(attributes) do
            table.insert(keys, key)
        end

        table.sort(keys)

        for _, key in ipairs(keys) do
            addLine(
                tostring(key) ..
                " = " ..
                safeToString(attributes[key]),
                1
            )
        end
    end

    addLine("", 0)
    addLine("REQUIRE RESULT", 0)

    local success, result = pcall(function()
        return require(module)
    end)

    if not success then
        addLine("ERROR", 1)
        addLine(
            safeToString(result),
            2
        )

        Status.Text = "Require failed"
        return
    end

    local resultType = valueType(result)

    addLine(
        "Type: " ..
        resultType,
        1
    )

    if type(result) == "table" then
        addLine("", 0)

        inspectValue(
            result,
            1,
            {},
            nil
        )
    else
        addLine(
            "Value: " ..
            safeToString(result),
            1
        )
    end

    Status.Text =
        "Loaded: " ..
        module.Name
end

