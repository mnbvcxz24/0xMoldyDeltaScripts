local function addLine(text, depth)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -8, 0, 15)
    label.BackgroundTransparency = 1
    label.Text = string.rep("    ", depth or 0) .. tostring(text)
    label.TextColor3 = Color3.fromRGB(210, 210, 220)
    label.TextSize = 9
    label.Font = Enum.Font.Code
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextYAlignment = Enum.TextYAlignment.Center
    label.TextWrapped = false
    label.Parent = Output

    task.defer(function()
        Output.CanvasSize = UDim2.fromOffset(0, OutputLayout.AbsoluteContentSize.Y + 10)
        Output.CanvasPosition = Vector2.new(
            0,
            math.max(
                0,
                OutputLayout.AbsoluteContentSize.Y - Output.AbsoluteWindowSize.Y
            )
        )
    end)

    return label
end

local function safeToString(value)
    local ok, result = pcall(function()
        return tostring(value)
    end)

    if ok then
        return result
    end

    return "<tostring failed>"
end

local function valueType(value)
    local ok, result = pcall(function()
        return typeof(value)
    end)

    if ok then
        return result
    end

    return type(value)
end

local function inspectValue(value, depth, visited, keyName)
    if depth > 12 then
        addLine(tostring(keyName or "") .. " = <max depth>", depth)
        return
    end

    local luaType = type(value)
    local robloxType = valueType(value)

    if luaType == "table" then
        if visited[value] then
            addLine(
                tostring(keyName or "") .. " = <recursive table>",
                depth
            )
            return
        end

        visited[value] = true

        local prefix = ""

        if keyName ~= nil then
            prefix = tostring(keyName) .. " = "
        end

        addLine(
            prefix .. "{",
            depth
        )

        local entries = {}

        local ok = pcall(function()
            for key, childValue in pairs(value) do
                table.insert(entries, {
                    key = key,
                    value = childValue
                })
            end
        end)

        if not ok then
            addLine("<unable to enumerate table>", depth + 1)
        else
            table.sort(entries, function(a, b)
                return safeToString(a.key) < safeToString(b.key)
            end)

            for _, entry in ipairs(entries) do
                inspectValue(
                    entry.value,
                    depth + 1,
                    visited,
                    entry.key
                )
            end
        end

        addLine("}", depth)

        return
    end

    if luaType == "function" then
        addLine(
            tostring(keyName or "function") ..
            " = <function>",
            depth
        )
        return
    end

    if luaType == "thread" then
        addLine(
            tostring(keyName or "thread") ..
            " = <thread>",
            depth
        )
        return
    end

    if luaType == "userdata" then
        addLine(
            tostring(keyName or "userdata") ..
            " = <userdata> [" ..
            robloxType ..
            "]",
            depth
        )
        return
    end

    local prefix = ""

    if keyName ~= nil then
        prefix = tostring(keyName) .. " = "
    end

    addLine(
        prefix ..
        safeToString(value) ..
        " [" ..
        robloxType ..
        "]",
        depth
    )
end

local function inspectModule(module)
    clearOutput()

    if not module then
        addLine("No module selected.", 0)
        return
    end

    SelectedLabel.Text =
        "Selected: " ..
        module:GetFullName()

    addLine("MODULE", 0)
    addLine(module.Name, 1)
    addLine("Path: " .. module:GetFullName(), 1)
    addLine("Class: " .. module.ClassName, 1)

    local attributes = module:GetAttributes()

    if next(attributes) then
        addLine("", 0)
        addLine("ATTRIBUTES", 0)

        local keys = {}

        for key in pairs(attributes) do
            table.insert(keys, key)
        end

        table.sort(keys)

        for _, key in ipairs(keys) do
            addLine(
                tostring(key) ..
                " = " ..
                safeToString(attributes[key]),
                1
            )
        end
    end

    addLine("", 0)
    addLine("REQUIRE RESULT", 0)

    local success, result = pcall(function()
        return require(module)
    end)

    if not success then
        addLine("ERROR", 1)
        addLine(safeToString(result), 2)
        Status.Text = "Require failed"
        return
    end

    local resultType = valueType(result)

    addLine(
        "Type: " ..
        resultType,
        1
    )

    if type(result) == "table" then
        addLine("", 0)
        inspectValue(
            result,
            1,
            {},
            nil
        )
    else
        addLine(
            "Value: " ..
            safeToString(result),
            1
        )
    end

    Status.Text =
        "Loaded: " ..
        module.Name
end

local function createModuleButton(module)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -6, 0, 24)
    button.BackgroundColor3 = Color3.fromRGB(35, 35, 42)
    button.BorderSizePixel = 0
    button.Text = module.Name
    button.TextColor3 = Color3.fromRGB(220, 220, 230)
    button.TextSize = 9
    button.Font = Enum.Font.Gotham
    button.TextXAlignment = Enum.TextXAlignment.Left
    button.Active = true
    button.ZIndex = 5
    button.Parent = ModuleList

    local padding = Instance.new("UIPadding")
    padding.PaddingLeft = UDim.new(0, 6)
    padding.Parent = button

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 4)
    corner.Parent = button

    button.MouseButton1Click:Connect(function()
        selectedModule = module

        for _, item in pairs(moduleButtons) do
            item.BackgroundColor3 = Color3.fromRGB(35, 35, 42)
        end

        button.BackgroundColor3 = Color3.fromRGB(55, 85, 65)

        inspectModule(module)
    end)

    moduleButtons[module] = button
end

local function rebuildModuleList()
    for _, child in ipairs(ModuleList:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    moduleButtons = {}

    local searchText = string.lower(Search.Text)

    for _, module in ipairs(allModules) do
        local name = string.lower(module.Name)
        local path = string.lower(module:GetFullName())

        if searchText == "" or
            string.find(name, searchText, 1, true) or
            string.find(path, searchText, 1, true) then

            createModuleButton(module)
        end
    end

    task.defer(function()
        ModuleList.CanvasSize = UDim2.fromOffset(
            0,
            ModuleLayout.AbsoluteContentSize.Y + 10
        )
    end)
end

local function scanModules()
    allModules = {}

    for _, descendant in ipairs(ReplicatedStorage:GetDescendants()) do
        if descendant:IsA("ModuleScript") then
            table.insert(allModules, descendant)
        end
    end

    table.sort(allModules, function(a, b)
        return a:GetFullName() < b:GetFullName()
    end)

    rebuildModuleList()

    Status.Text =
        "Found " ..
        tostring(#allModules) ..
        " ModuleScripts"
end

Search:GetPropertyChangedSignal("Text"):Connect(function()
    rebuildModuleList()
end)

