local function safeToString(value)
    local ok, result = pcall(function()
        return tostring(value)
    end)

    if ok then
        return result
    end

    return "<tostring failed>"
end

local function valueType(value)
    local ok, result = pcall(function()
        return typeof(value)
    end)

    if ok then
        return result
    end

    return type(value)
end

