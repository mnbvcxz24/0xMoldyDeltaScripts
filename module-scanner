local function safeString(value)
    local ok,result=pcall(function()
        return tostring(value)
    end)
    return ok and result or "<error>"
end

local function formatValue(value)
    if value==nil then
        return "nil [nil]"
    end

    local t=typeof(value)

    if t=="Instance" then
        local ok,name=pcall(function()
            return value:GetFullName()
        end)

        if ok then
            return name.." [Instance]"
        end
    end

    if t=="table" then
        return "table"
    end

    if t=="function" then
        return "<function>"
    end

    if t=="thread" then
        return "<thread>"
    end

    if t=="userdata" then
        return safeString(value).." [userdata]"
    end

    return safeString(value).." ["..t.."]"
end

