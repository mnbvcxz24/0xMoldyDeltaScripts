local function hasMatchingDescendant(instance, searchText)
    if searchText == "" then
        return true
    end

    local name = string.lower(instance.Name)
    local className = string.lower(instance.ClassName)

    if string.find(name, searchText, 1, true) or
        string.find(className, searchText, 1, true) then
        return true
    end

    local ok, descendants = pcall(function()
        return instance:GetDescendants()
    end)

    if not ok then
        return false
    end

    for _, descendant in ipairs(descendants) do
        local descendantName =
            string.lower(descendant.Name)

        local descendantClass =
            string.lower(descendant.ClassName)

        if string.find(
            descendantName,
            searchText,
            1,
            true
        ) or string.find(
            descendantClass,
            searchText,
            1,
            true
        ) then
            return true
        end
    end

    return false
end

local function getIcon(instance)
    if instance:IsA("ModuleScript") then
        return "◆"
    end

    if instance:IsA("Folder") then
        return "□"
    end

    if instance:IsA("Script") or
        instance:IsA("LocalScript") then
        return "▣"
    end

    if instance:IsA("ValueBase") then
        return "●"
    end

    if #instance:GetChildren() > 0 then
        return "▸"
    end

    return "•"
end

local rebuildTree

local function createTreeNode(instance, depth)
    local searchText =
        string.lower(Search.Text)

    if searchText ~= "" and
        not hasMatchingDescendant(
            instance,
            searchText
        ) then
        return
    end

    local children = instance:GetChildren()

    table.sort(children, function(a, b)
        return a.Name < b.Name
    end)

    local hasChildren = #children > 0

    local button = Instance.new("TextButton")
    button.Size = UDim2.new(
        1,
        -6,
        0,
        22
    )
    button.BackgroundTransparency = 1
    button.BorderSizePixel = 0
    button.TextColor3 =
        Color3.fromRGB(215, 215, 225)
    button.TextSize = 9
    button.Font = Enum.Font.Gotham
    button.TextXAlignment = Enum.TextXAlignment.Left
    button.TextTruncate = Enum.TextTruncate.AtEnd
    button.Active = true
    button.ZIndex = 5
    button.Parent = Tree

    local prefix = ""

    for _ = 1, depth do
        prefix = prefix .. "    "
    end

    local arrow = ""

    if hasChildren then
        if expanded[instance] then
            arrow = "▼ "
        else
            arrow = "▶ "
        end
    else
        arrow = "  "
    end

    button.Text =
        prefix ..
        arrow ..
        getIcon(instance) ..
        " " ..
        instance.Name

    if instance:IsA("ModuleScript") then
        button.TextColor3 =
            Color3.fromRGB(180, 220, 190)
    elseif instance:IsA("Folder") then
        button.TextColor3 =
            Color3.fromRGB(220, 210, 170)
    end

    local padding = Instance.new("UIPadding")
    padding.PaddingLeft = UDim.new(0, 4)
    padding.Parent = button

    nodeButtons[instance] = button

    button.MouseButton1Click:Connect(function()
        if hasChildren then
            expanded[instance] =
                not expanded[instance]

            rebuildTree()
        end

        for _, item in pairs(nodeButtons) do
            item.BackgroundColor3 =
                Color3.fromRGB(27, 27, 33)
        end

        button.BackgroundColor3 =
            Color3.fromRGB(55, 85, 65)

        inspectInstance(instance)
    end)

    if expanded[instance] then
        for _, child in ipairs(children) do
            createTreeNode(
                child,
                depth + 1
            )
        end
    end
end

rebuildTree = function()
    for _, child in ipairs(Tree:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
