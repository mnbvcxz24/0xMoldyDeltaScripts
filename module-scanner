local function addSection(name)
    addLine("",0)
    addLine(name,0)
end

local function inspectValue(value,depth,visited,keyName)
    if depth>12 then
        addLine(tostring(keyName or "").." = <max depth>",depth)
        return
    end

    local luaType=type(value)
    local robloxType=valueType(value)

    if luaType=="table" then
        if visited[value] then
            addLine(tostring(keyName or "").." = <recursive table>",depth)
            return
        end

        visited[value]=true

        local prefix=""
        if keyName~=nil then
            prefix=tostring(keyName).." = "
        end

        addLine(prefix.."{",depth)

        local entries={}
        local ok=pcall(function()
            for key,childValue in pairs(value) do
                table.insert(entries,{
                    key=key,
                    value=childValue
                })
            end
        end)

        if not ok then
            addLine("<unable to enumerate table>",depth+1)
        else
            table.sort(entries,function(a,b)
                return safeToString(a.key)<safeToString(b.key)
            end)

            for _,entry in ipairs(entries) do
                inspectValue(
                    entry.value,
                    depth+1,
                    visited,
                    entry.key
                )
            end
        end

        addLine("}",depth)
        return
    end

    if luaType=="function" then
        addLine(
            tostring(keyName or "function").." = <function>",
            depth
        )
        return
    end

    if luaType=="thread" then
        addLine(
            tostring(keyName or "thread").." = <thread>",
            depth
        )
        return
    end

    if luaType=="userdata" then
        addLine(
            tostring(keyName or "userdata")..
            " = <userdata> ["..
            robloxType..
            "]",
            depth
        )
        return
    end

    local prefix=""
    if keyName~=nil then
        prefix=tostring(keyName).." = "
    end

    addLine(
        prefix..
        safeToString(value)..
        " ["..
        robloxType..
        "]",
        depth
    )
end

local function inspectBasePart(instance)
    addSection("BASEPART")

    addLine("Position = "..safeToString(instance.Position),1)
    addLine("Size = "..safeToString(instance.Size),1)
    addLine("CFrame = "..safeToString(instance.CFrame),1)
    addLine("Orientation = "..safeToString(instance.Orientation),1)
    addLine("Anchored = "..safeToString(instance.Anchored),1)
    addLine("CanCollide = "..safeToString(instance.CanCollide),1)
    addLine("CanTouch = "..safeToString(instance.CanTouch),1)
    addLine("CanQuery = "..safeToString(instance.CanQuery),1)
    addLine("Transparency = "..safeToString(instance.Transparency),1)
    addLine("Material = "..safeToString(instance.Material),1)
    addLine("Massless = "..safeToString(instance.Massless),1)
    addLine("AssemblyMass = "..safeToString(instance.AssemblyMass),1)
    addLine("AssemblyLinearVelocity = "..safeToString(instance.AssemblyLinearVelocity),1)
    addLine("AssemblyAngularVelocity = "..safeToString(instance.AssemblyAngularVelocity),1)

    if instance:IsA("Part") then
        addLine("Shape = "..safeToString(instance.Shape),1)
    end

    if instance:IsA("MeshPart") then
        addLine("MeshId = "..safeToString(instance.MeshId),1)
        addLine("TextureID = "..safeToString(instance.TextureID),1)
    end
end

local function inspectModel(instance)
    addSection("MODEL")

    addLine("PrimaryPart = "..safeToString(instance.PrimaryPart),1)
    addLine("WorldPivot = "..safeToString(instance:GetPivot()),1)

    local ok,boundingCFrame,boundingSize=pcall(function()
        local cf,size=instance:GetBoundingBox()
        return true,cf,size
    end)

    if ok and boundingCFrame then
        addLine("BoundingBox CFrame = "..safeToString(boundingCFrame),1)
        addLine("BoundingBox Size = "..safeToString(boundingSize),1)
    end
end

local function inspectTool(instance)
    addSection("TOOL")

    addLine("RequiresHandle = "..safeToString(instance.RequiresHandle),1)
    addLine("CanBeDropped = "..safeToString(instance.CanBeDropped),1)
    addLine("Enabled = "..safeToString(instance.Enabled),1)

    local handle=instance:FindFirstChild("Handle")
    if handle then
        addLine("Handle = "..handle:GetFullName(),1)
        addLine("Handle Class = "..handle.ClassName,1)

        if handle:IsA("BasePart") then
            addLine("Handle Position = "..safeToString(handle.Position),2)
            addLine("Handle Size = "..safeToString(handle.Size),2)
        end
    else
        addLine("Handle = <none>",1)
    end
end

