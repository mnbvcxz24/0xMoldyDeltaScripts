local function addDetail(text,depth,size,color,bold)
    local label=Instance.new("TextLabel")
    label.Size=UDim2.new(1,-10,0,size or 16)
    label.BackgroundTransparency=1
    label.Text=string.rep("  ",depth or 0)..safeString(text)
    label.TextColor3=color or Color3.fromRGB(215,215,225)
    label.TextSize=7
    label.Font=bold and Enum.Font.GothamBold or Enum.Font.Code
    label.TextXAlignment=Enum.TextXAlignment.Left
    label.TextYAlignment=Enum.TextYAlignment.Center
    label.TextTruncate=Enum.TextTruncate.AtEnd
    label.Parent=Details
    return label
end

local function addSection(text)
    addDetail(text,0,19,Color3.fromRGB(100,190,125),true)
end

local function sortedChildren(instance)
    local children=instance:GetChildren()

    table.sort(children,function(a,b)
        local ac=a:IsA("Folder") and 0 or a:IsA("ModuleScript") and 1 or 2
        local bc=b:IsA("Folder") and 0 or b:IsA("ModuleScript") and 1 or 2

        if ac~=bc then
            return ac<bc
        end

        return a.Name:lower()<b.Name:lower()
    end)

    return children
end

local function matchesSearch(instance)
    if searchText=="" then
        return true
    end

    local q=searchText:lower()

    if instance.Name:lower():find(q,1,true) then
        return true
    end

    if instance.ClassName:lower():find(q,1,true) then
        return true
    end

    local parent=instance.Parent

    while parent and parent~=service do
        if parent.Name:lower():find(q,1,true) then
            return true
        end

        parent=parent.Parent
    end

    return false
end

local function hasMatchingDescendant(instance)
    if searchText=="" then
        return true
    end

    if matchesSearch(instance) then
        return true
    end

    for _,child in ipairs(instance:GetChildren()) do
        if hasMatchingDescendant(child) then
            return true
        end
    end

    return false
end

local function inspectValue(value,depth,path,visited,maxDepth)
    maxDepth=maxDepth or 12

    local valueType=typeof(value)

    if valueType=="table" then
        if visited[value] then
            addDetail(path.." = <recursive table>",depth)
            return
        end

        if depth>=maxDepth then
            addDetail(path.." = <max depth reached>",depth)
            return
        end

        visited[value]=true

        local keys={}

        for key in pairs(value) do
            table.insert(keys,key)
        end

        table.sort(keys,function(a,b)
            local sa=safeString(a)
            local sb=safeString(b)

            return sa<sb
        end)

        addDetail(path.." = table {"..tostring(#keys).." keys}",depth,16,Color3.fromRGB(215,215,225),true)

        for _,key in ipairs(keys) do
            local ok,result=pcall(function()
                return value[key]
            end)

            if ok then
                local keyText="["..safeString(key).."]"

                if typeof(result)=="table" then
                    inspectValue(result,depth+1,keyText,path and visited or visited,maxDepth)
                else
                    addDetail(keyText.." = "..formatValue(result),depth+1)
                end
            else
                addDetail(keyText.." = <read error>",depth+1,16,Color3.fromRGB(210,100,100))
            end
        end

        return
    end

    addDetail(path.." = "..formatValue(value),depth)
end

local function inspectSpecial(instance,depth)
    if instance:IsA("ValueBase") then
        addDetail("Value = "..formatValue(instance.Value),depth+1)
    end

    if instance:IsA("BasePart") then
        addDetail("Position = "..safeString(instance.Position),depth+1)
        addDetail("Size = "..safeString(instance.Size),depth+1)
        addDetail("CFrame = "..safeString(instance.CFrame),depth+1)
        addDetail("Anchored = "..safeString(instance.Anchored),depth+1)
        addDetail("CanCollide = "..safeString(instance.CanCollide),depth+1)
        addDetail("CanTouch = "..safeString(instance.CanTouch),depth+1)
        addDetail("CanQuery = "..safeString(instance.CanQuery),depth+1)
        addDetail("Transparency = "..safeString(instance.Transparency),depth+1)
        addDetail("Massless = "..safeString(instance.Massless),depth+1)
    end

    if instance:IsA("ProximityPrompt") then
        addDetail("Enabled = "..safeString(instance.Enabled),depth+1)
        addDetail("ActionText = "..safeString(instance.ActionText),depth+1)
        addDetail("ObjectText = "..safeString(instance.ObjectText),depth+1)
        addDetail("HoldDuration = "..safeString(instance.HoldDuration),depth+1)
        addDetail("MaxActivationDistance = "..safeString(instance.MaxActivationDistance),depth+1)
        addDetail("RequiresLineOfSight = "..safeString(instance.RequiresLineOfSight),depth+1)
        addDetail("KeyboardKeyCode = "..safeString(instance.KeyboardKeyCode),depth+1)
        addDetail("GamepadKeyCode = "..safeString(instance.GamepadKeyCode),depth+1)
        addDetail("Style = "..safeString(instance.Style),depth+1)
    end

    if instance:IsA("ClickDetector") then
        addDetail("MaxActivationDistance = "..safeString(instance.MaxActivationDistance),depth+1)
    end

    if instance:IsA("RemoteEvent") then
        addDetail("RemoteEvent",depth+1,16,Color3.fromRGB(190,150,220),true)
    elseif instance:IsA("RemoteFunction") then
        addDetail("RemoteFunction",depth+1,16,Color3.fromRGB(190,150,220),true)
    elseif instance:IsA("BindableEvent") then
        addDetail("BindableEvent",depth+1,16,Color3.fromRGB(190,150,220),true)
    elseif instance:IsA("BindableFunction") then
        addDetail("BindableFunction",depth+1,16,Color3.fromRGB(190,150,220),true)
    end
end

local function inspectAttributes(instance,depth)
    local attributes=instance:GetAttributes()
    local names={}

    for name in pairs(attributes) do
        table.insert(names,name)
    end

    table.sort(names)

    if #names==0 then
        addDetail("<none>",depth)
        return
    end

    for _,name in ipairs(names) do
        addDetail(name.." = "..formatValue(attributes[name]),depth)
    end
end

local function inspectInstanceTree(instance,depth,visited)
    addDetail(instance.Name.." ["..instance.ClassName.."]",depth,16,Color3.fromRGB(215,215,225),true)

    local attributes=instance:GetAttributes()

    if next(attributes) then
        addDetail("ATTRIBUTES",depth+1,16,Color3.fromRGB(100,190,125),true)
        inspectAttributes(instance,depth+2)
    end

    inspectSpecial(instance,depth)

    local children=sortedChildren(instance)

    for _,child in ipairs(children) do
        inspectInstanceTree(child,depth+1,visited)
    end
end

local function inspectModule(instance)
    clearDetails()

    addSection("MODULESCRIPT")
    addDetail("Name: "..instance.Name,1)
    addDetail("Class: "..instance.ClassName,1)
    addDetail("Path: "..instance:GetFullName(),1)
    addDetail("Read-only inspection",1,16,Color3.fromRGB(130,180,210))

    addSection("ATTRIBUTES")
    inspectAttributes(instance,1)

    addSection("CHILDREN")

    local children=sortedChildren(instance)

    if #children==0 then
        addDetail("<none>",1)
    else
        for _,child in ipairs(children) do
            inspectInstanceTree(child,1,{})
        end
    end

    addSection("REQUIRE RESULT")

    local ok,result=pcall(function()
        return require(instance)
    end)

    if not ok then
        addDetail("require() failed",1,16,Color3.fromRGB(220,100,100),true)
        addDetail(safeString(result),2)
        return
    end

    addDetail("Return type: "..typeof(result),1)

    if typeof(result)=="table" then
        inspectValue(result,1,"RETURN",{},14)
    else
        addDetail("RETURN = "..formatValue(result),1)
    end

    updateCanvas(Details,DetailLayout)
end

local function inspectInstance(instance)
    if not instance or not instance.Parent then
        return
    end

    selected=instance
    clearDetails()

    addSection("INSTANCE")
    addDetail("Name: "..instance.Name,1)
    addDetail("Class: "..instance.ClassName,1)
    addDetail("Full Path: "..instance:GetFullName(),1)
    addDetail("Parent: "..(instance.Parent and instance.Parent:GetFullName() or "nil"),1)
    addDetail("Direct Children: "..tostring(#instance:GetChildren()),1)
    addDetail("Descendants: "..tostring(#instance:GetDescendants()),1)

    addSection("ATTRIBUTES")
    inspectAttributes(instance,1)

    addSection("SPECIAL DATA")
    inspectSpecial(instance,1)

    if instance:IsA("ModuleScript") then
        addSection("MODULE")
        addDetail("Use REQUIRE to inspect the returned value.",1,16,Color3.fromRGB(180,180,200))
        
        local button=Instance.new("TextButton")
        button.Size=UDim2.new(1,-12,0,26)
        button.BackgroundColor3=Color3.fromRGB(45,85,60)
        button.BorderSizePixel=0
        button.Text="REQUIRE + DEEP INSPECT"
        button.TextColor3=Color3.fromRGB(240,240,240)
        button.TextSize=7
        button.Font=Enum.Font.GothamBold
        button.Parent=Details

        local corner=Instance.new("UICorner")
        corner.CornerRadius=UDim.new(0,4)
        corner.Parent=button

        button.MouseButton1Click:Connect(function()
            if selected==instance then
                inspectModule(instance)
                Status.Text="Required: "..instance:GetFullName()
            end
        end)
    end

    addSection("FULL INSTANCE TREE")

    for _,child in ipairs(sortedChildren(instance)) do
        inspectInstanceTree(child,1,{})
    end

    updateCanvas(Details,DetailLayout)
    Status.Text="Inspecting: "..instance:GetFullName()
end

local function clearTree()
    for _,child in ipairs(Tree:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    treeButtons={}
    Tree.CanvasSize=UDim2.new()
end

local function addTreeNode(instance,depth)
    if not hasMatchingDescendant(instance) then
        return
    end

    local children=sortedChildren(instance)
    local hasChildren=#children>0

    local button=Instance.new("TextButton")
    button.Size=UDim2.new(1,-6,0,22)
    button.BackgroundColor3=Color3.fromRGB(32,32,39)
    button.BorderSizePixel=0
    button.Text=""
    button.AutoButtonColor=false
    button.Parent=Tree

    local arrow=hasChildren and (expanded[instance] and "▼" or "▶") or "•"

    local text=string.rep("   ",depth)..arrow.." "..instance.Name.." ["..instance.ClassName.."]"

    button.Text=text
    button.TextColor3=Color3.fromRGB(215,215,225)
    button.TextSize=7
    button.Font=Enum.Font.Code
    button.TextXAlignment=Enum.TextXAlignment.Left
    button.TextTruncate=Enum.TextTruncate.AtEnd

    treeButtons[instance]=button

    if instance==selected then
        button.BackgroundColor3=Color3.fromRGB(55,85,65)
        selectedButton=button
    end

    button.MouseButton1Click:Connect(function()
        if hasChildren then
            expanded[instance]=not expanded[instance]
            rebuildTree()
        end

        inspectInstance(instance)
    end)

    if expanded[instance] then
        for _,child in ipairs(children) do
            addTreeNode(child,depth+1)
        end
    end
end

function rebuildTree()
    clearTree()

    if not service then
        return
    end

    addTreeNode(service,0)

    updateCanvas(Tree,TreeLayout)
end

local function populateServices()
    for _,child in ipairs(ServiceList:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    for _,object in ipairs(Services) do
        if object and object.Parent then
            local button=Instance.new("TextButton")
            button.Size=UDim2.new(1,-4,0,25)
            button.BackgroundColor3=object==service and Color3.fromRGB(55,85,65) or Color3.fromRGB(35,35,42)
            button.BorderSizePixel=0
            button.Text=object.Name.." ["..object.ClassName.."]"
            button.TextColor3=Color3.fromRGB(225,225,230)
            button.TextSize=7
            button.Font=Enum.Font.Code
            button.TextXAlignment=Enum.TextXAlignment.Left
            button.Parent=ServiceList
            button.ZIndex=22

            button.MouseButton1Click:Connect(function()
                service=object
                ServiceButton.Text=object.Name
                ServiceMenu.Visible=false
                expanded={}
                selected=nil
                clearDetails()
                rebuildTree()
                Status.Text="Service: "..object.Name
                populateServices()
            end)
        end
    end

    updateCanvas(ServiceList,ServiceLayout)
end

