local function trimText(text)
    return string.match(text,"^%s*(.-)%s*$") or ""
end

local function findInstanceFromPath(path)
    path=trimText(path)

    if path=="" then
        return nil,"Path is empty"
    end

    if string.sub(path,1,5)=="game." then
        path=string.sub(path,6)
    elseif path=="game" then
        return game,nil
    end

    local parts={}

    for part in string.gmatch(path,"[^%.]+") do
        part=trimText(part)

        if part~="" then
            table.insert(parts,part)
        end
    end

    if #parts==0 then
        return nil,"Invalid path"
    end

    local current

    local ok,service=pcall(function()
        return game:GetService(parts[1])
    end)

    if ok and service then
        current=service
    else
        return nil,"Service not found: "..parts[1]
    end

    for i=2,#parts do
        local child=current:FindFirstChild(parts[i])

        if not child then
            return nil,"Not found: "..parts[i]
        end

        current=child
    end

    return current
end

local function selectPath(instance,path)
    if not instance then
        return
    end

    local parts={}

    for part in string.gmatch(path,"[^%.]+") do
        part=trimText(part)

        if part=="game" and #parts==0 then
        elseif part~="" then
            table.insert(parts,part)
        end
    end

    if #parts==0 then
        return
    end

    local ok,service=pcall(function()
        return game:GetService(parts[1])
    end)

    if ok and service then
        selectedService=service
        ServiceButton.Text=parts[1].." ▼"
    end

    expanded={}

    local current=instance

    while current and current~=selectedService do
        expanded[current]=true
        current=current.Parent
    end

    expanded[selectedService]=true

    Search.Text=""

    selectedInstance=instance

    rebuildTree()

    for _,button in pairs(nodeButtons) do
        button.BackgroundColor3=Color3.fromRGB(27,27,33)
    end

    local targetButton=nodeButtons[instance]

    if targetButton then
        targetButton.BackgroundColor3=Color3.fromRGB(55,85,65)

        task.defer(function()
            local targetY=targetButton.AbsolutePosition.Y-Tree.AbsolutePosition.Y+Tree.CanvasPosition.Y
            Tree.CanvasPosition=Vector2.new(0,math.max(0,targetY-80))
        end)
    end

    inspectInstance(instance)
end

