    serviceButtons = {}

    for _, serviceName in ipairs(serviceNames) do
        local ok, service =
            pcall(function()
                return game:GetService(serviceName)
            end)

        if ok and service then
            createServiceButton(serviceName)
        end
    end

    ServiceMenu.Size =
        UDim2.fromOffset(
            150,
            math.min(
                220,
                #serviceButtons * 23 + 4
            )
        )
end

