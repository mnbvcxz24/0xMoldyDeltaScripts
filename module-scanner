local function inspectInstance(instance)
    clearOutput()

    if not instance then
        SelectedLabel.Text="Selected: --"
        addLine("Nothing selected.",0)
        return
    end

    selectedInstance=instance

    SelectedLabel.Text="Selected: "..safeToString(instance.Name)

    addLine("INSTANCE",0)
    addLine(instance.Name,1)
    addLine("Path: "..instance:GetFullName(),1)
    addLine("Class: "..instance.ClassName,1)

    local attributes=instance:GetAttributes()

    if next(attributes) then
        addSection("ATTRIBUTES")

        local keys={}
        for key in pairs(attributes) do
            table.insert(keys,key)
        end

        table.sort(keys)

        for _,key in ipairs(keys) do
            addLine(
                tostring(key)..
                " = "..
                safeToString(attributes[key]),
                1
            )
        end
    end

    if instance:IsA("BasePart") then
        inspectBasePart(instance)
    end

    if instance:IsA("Model") then
        inspectModel(instance)
    end

    if instance:IsA("Tool") then
        inspectTool(instance)
    end

    if instance:IsA("Humanoid") then
        inspectHumanoid(instance)
    end

    if instance:IsA("ModuleScript") then
        addSection("MODULE")
        addLine(
            "Press REQUIRE to inspect the returned value.",
            1
        )
    elseif instance:IsA("ValueBase") then
        addSection("VALUE")
        addLine(
            safeToString(instance.Value)..
            " ["..
            valueType(instance.Value)..
            "]",
            1
        )
    end

    local children=instance:GetChildren()

    if #children>0 then
        addSection("CHILDREN ("..tostring(#children)..")")

        table.sort(children,function(a,b)
            return a.Name<b.Name
        end)

        for _,child in ipairs(children) do
            addLine(
                child.Name..
                " ["..
                child.ClassName..
                "]",
                1
            )
        end
    end

    Status.Text="Selected: "..instance:GetFullName()
end

local function requireModule(module)
    clearOutput()

    if not module or not module:IsA("ModuleScript") then
        addLine("Selected instance is not a ModuleScript.",0)
        Status.Text="Require unavailable"
        return
    end

    SelectedLabel.Text="Selected: "..module.Name

    addLine("MODULE",0)
    addLine(module.Name,1)
    addLine("Path: "..module:GetFullName(),1)
    addLine("Class: "..module.ClassName,1)

    local attributes=module:GetAttributes()

    if next(attributes) then
        addSection("ATTRIBUTES")

        local keys={}
        for key in pairs(attributes) do
            table.insert(keys,key)
        end

        table.sort(keys)

        for _,key in ipairs(keys) do
            addLine(
                tostring(key)..
                " = "..
                safeToString(attributes[key]),
                1
            )
        end
    end

    addSection("REQUIRE RESULT")

    local success,result=pcall(function()
        return require(module)
    end)

    if not success then
        addLine("ERROR",1)
        addLine(safeToString(result),2)
        Status.Text="Require failed"
        return
    end

    addLine("Type: "..valueType(result),1)

    if type(result)=="table" then
        addLine("",0)
        inspectValue(result,1,{},nil)
    else
        addLine("Value: "..safeToString(result),1)
    end

    Status.Text="Loaded: "..module.Name
end

