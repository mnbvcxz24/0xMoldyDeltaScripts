local function testFunction(fn, label, ...)
    local arguments = {...}

    local success, a, b, c, d, e = pcall(function()
        return fn(table.unpack(arguments))
    end)

    if not success then
        addResult(
            label,
            "ERROR",
            tostring(a)
        )
        return
    end

    local values = {a, b, c, d, e}

    local returned = {}

    for i, value in ipairs(values) do
        if value ~= nil then
            table.insert(
                returned,
                "#" .. tostring(i) ..
                " [" .. typeof(value) .. "] " ..
                safeValue(value)
            )
        end
    end

    if #returned == 0 then
        addResult(
            label,
            "nil / no values",
            "Function completed without an observable return value."
        )
    else
        addResult(
            label,
            tostring(#returned) .. " return(s)",
            table.concat(returned, " | ")
        )
    end
end

local function inspect()
    local gameServices = ReplicatedStorage:FindFirstChild("GameServices")

    if not gameServices then
        Info.Text = "GameServices not found."
        return
    end

    local module = gameServices:FindFirstChild("EggLuckBillboard")

    if not module or not module:IsA("ModuleScript") then
        Info.Text = "EggLuckBillboard ModuleScript not found."
        return
    end

    local required, moduleResult = pcall(require, module)

    if not required then
        Info.Text = "require() failed:\n" .. tostring(moduleResult)
        return
    end

    if type(moduleResult) ~= "table" then
        Info.Text =
            "Module returned: " ..
            typeof(moduleResult) ..
            "\nExpected a table."
        return
    end

    local formatLuck = moduleResult.FormatLuck

    if type(formatLuck) ~= "function" then
        Info.Text = "FormatLuck was not found or is not a function."
        return
    end

    local source
    local line
    local name
    local parameterCount
    local variadic

    pcall(function()
        source, line, name, parameterCount, variadic =
            debug.info(formatLuck, "slna")
    end)

    Info.Text =
        "Function: " .. tostring(name or "unknown") ..
        "\nParameters: " .. tostring(parameterCount or "unknown") ..
        " | Variadic: " .. tostring(variadic or false) ..
        "\nSource: " .. tostring(source or "unknown") ..
        "\nDefined line: " .. tostring(line or "unknown")

    TestButton.MouseButton1Click:Connect(function()
        clearResults()

        addResult(
            "Function",
            "FormatLuck",
            "Controlled invocation tests. No Attach call."
        )

        testFunction(
            formatLuck,
            "No arguments"
        )

        testFunction(formatLuck, "Number: 0", 0)
        testFunction(formatLuck, "Number: 0.1", 0.1)
        testFunction(formatLuck, "Number: 0.25", 0.25)
        testFunction(formatLuck, "Number: 0.5", 0.5)
        testFunction(formatLuck, "Number: 0.75", 0.75)
        testFunction(formatLuck, "Number: 0.99", 0.99)
        testFunction(formatLuck, "Number: 1", 1)
        testFunction(formatLuck, "Number: 1.01", 1.01)
        testFunction(formatLuck, "Number: 1.25", 1.25)
        testFunction(formatLuck, "Number: 1.5", 1.5)
        testFunction(formatLuck, "Number: 1.75", 1.75)
        testFunction(formatLuck, "Number: 2", 2)
        testFunction(formatLuck, "Number: 2.5", 2.5)
        testFunction(formatLuck, "Number: 3", 3)
        testFunction(formatLuck, "Number: 4", 4)
        testFunction(formatLuck, "Number: 5", 5)
        testFunction(formatLuck, "Number: 10", 10)
        testFunction(formatLuck, "Number: 100", 100)
    end)
end

inspect()
