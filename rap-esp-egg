local Rayfield = loadstring(game:HttpGet("https://sirius.menu/gen2"))()

local Window = Rayfield:CreateWindow({
    name = "Egg ESP",
    subtitle = "Active Eggs",
    sidebarLayout = true,
})

local MainTab = Window:CreateTab({
    name = "ESP",
    icon = 93364949241311,
})

local ESPEnabled = false

MainTab:CreateToggle({
    name = "Egg ESP",
    flag = "EggESP",
    callback = function(value)
        ESPEnabled = value
    end,
})

MainTab:CreateButton({
    name = "Scan Active Eggs",
    callback = function()
        local ReplicatedStorage = game:GetService("ReplicatedStorage")
        local ServerData = ReplicatedStorage:FindFirstChild("ServerData")
        local ActiveEggs = ServerData and ServerData:FindFirstChild("ActiveEggs")

        if not ActiveEggs then
            return
        end

        for _, egg in ipairs(ActiveEggs:GetChildren()) do
            local galaxy = egg:FindFirstChild("Galaxy")

            local galaxyValue = galaxy and galaxy.Value or "nil"

            Rayfield:Notify({
                Title = egg.Name,
                Content = "Galaxy: " .. tostring(galaxyValue),
                Duration = 3,
            })
        end
    end,
})
