ScanButton.MouseButton1Click:Connect(function()
    DebugLines = {}
    DebugText.Text = ""
    DebugBox.CanvasPosition = Vector2.new(0, 0)

    AddDebug("========== EGG SCAN ==========")

    local success, err = pcall(function()
        local ActiveEggs = getActiveEggs()

        if not ActiveEggs then
            AddDebug("[ERROR] ActiveEggs not found")
            return
        end

        refreshEggTypes()
        rebuildFilter()

        local eggs = ActiveEggs:GetChildren()

        EggCount.Text = "Active Eggs: " .. tostring(#eggs)

        local selectedName

        for name in pairs(SelectedEggs) do
            selectedName = name
            break
        end

        local eggLuckText = getEggLuckText(selectedName)
        local eggLuck = getEggLuck(selectedName)

        AddDebug("Egg: " .. tostring(selectedName))
        AddDebug("Egg Luck Text: " .. tostring(eggLuckText))
        AddDebug("Egg Luck Value: " .. tostring(eggLuck))

        local ranchLuckText = getRanchLuckText()
        local ranchLuck = getRanchLuck()

        AddDebug("Ranch Luck Text: " .. tostring(ranchLuckText))
        AddDebug("Ranch Luck Value: " .. tostring(ranchLuck))

        local selectedWeight
        local calculatedKG

        for _, egg in ipairs(eggs) do
            if egg:GetAttribute("Egg") == selectedName then
                selectedWeight = tonumber(egg:GetAttribute("Weight"))
                calculatedKG = calculateKG(selectedWeight, eggLuck, ranchLuck)
                break
            end
        end

        AddDebug("Weight: " .. tostring(selectedWeight))
        AddDebug("Calculated KG: " .. tostring(calculatedKG))
        AddDebug("Calculated KG Formatted: " .. formatKG(calculatedKG))

        AddDebug("Total Active Eggs: " .. tostring(#eggs))
        AddDebug("Filter: " .. tostring(selectedName or "--"))

        local counts = {}

        for _, egg in ipairs(eggs) do
            local eggName = egg:GetAttribute("Egg")

            if eggName and eggName ~= "" then
                counts[eggName] = (counts[eggName] or 0) + 1
            end
        end

        for eggName, count in pairs(counts) do
            AddDebug(tostring(eggName) .. " x " .. tostring(count))
        end

        if selectedName then
            local count = counts[selectedName] or 0

            FilterCount.Text = selectedName .. ": " .. tostring(count)

            AddDebug("Selected Eggs: " .. tostring(count))

            for _, egg in ipairs(eggs) do
                if egg:GetAttribute("Egg") == selectedName then
                    local position = egg:GetAttribute("Position")

                    AddDebug(
                        tostring(selectedName) ..
                        " | Position: " ..
                        typeof(position)
                    )
                end
            end
        else
            FilterCount.Text = "Selected Eggs: 0"
            AddDebug("No egg selected")
        end

        AddDebug("========== SCAN COMPLETE ==========")
    end)

    if not success then
        AddDebug("========== LUA ERROR ==========")
        AddDebug(tostring(err))
    end
end)

