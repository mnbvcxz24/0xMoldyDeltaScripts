local ESPObjects = {}

local function clearESP()
    for egg, data in pairs(ESPObjects) do
        if data.Part then
            pcall(function()
                data.Part:Destroy()
            end)
        end

        ESPObjects[egg] = nil
    end
end

local function getEggPosition(egg)
    local position = egg:GetAttribute("Position")

    if typeof(position) == "Vector3" then
        return position
    end

    if typeof(position) == "CFrame" then
        return position.Position
    end

    return nil
end

local function createESP(egg)
    if ESPObjects[egg] then
        return
    end

    local eggName = egg:GetAttribute("Egg") or "Egg"
    local position = getEggPosition(egg)

    if not position then
        AddDebug("[ESP ERROR] No usable Position: " .. tostring(eggName))
        return
    end

    local part = Instance.new("Part")
    part.Name = "EggESP_" .. egg.Name
    part.Size = Vector3.new(0.5, 0.5, 0.5)
    part.Position = position
    part.Anchored = true
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.Transparency = 1
    part.Parent = ESPFolder

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "EggLabel"
    billboard.Size = UDim2.fromOffset(180, 45)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = math.huge
    billboard.Parent = part

    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.Text = eggName
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextStrokeTransparency = 0
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.TextSize = textSize(13)
    label.Font = Enum.Font.GothamBold
    label.Parent = billboard

    ESPObjects[egg] = {
        Part = part,
        Label = label
    }
end

local function formatKG(kg)
    if not kg then
        return "--"
    end

    if kg >= 1000000 then
        return string.format("%.2fM KG", kg / 1000000)
    elseif kg >= 1000 then
        return string.format("%.2fK KG", kg / 1000)
    else
        return string.format("%.2f KG", kg)
    end
end

local function updateESP()
    if Toggle.Text ~= "ON" then
        clearESP()
        return
    end

    local selectedName

    for name in pairs(SelectedEggs) do
        selectedName = name
        break
    end

    if not selectedName then
        clearESP()
        FilterCount.Text = "Selected Eggs: 0"
        WeightLabel.Text = "Weight: --"
        KGLabel.Text = "Calculated KG: --"
        return
    end

    local ActiveEggs = getActiveEggs()

    if not ActiveEggs then
        clearESP()
        AddDebug("[ESP ERROR] ActiveEggs not found")
        return
    end

    local eggs = ActiveEggs:GetChildren()
    local activeEggSet = {}
    local total = 0
    local selectedWeight
    local selectedKG
    local eggLuck = getEggLuck(selectedName)
    local ranchLuck = getRanchLuck()

    for _, egg in ipairs(eggs) do
        if SelectedEggs[egg:GetAttribute("Egg")] then
            total = total + 1
            local weight = tonumber(egg:GetAttribute("Weight"))
            local kg = calculateKG(weight, eggLuck, ranchLuck)

            if selectedWeight == nil then
                selectedWeight = weight
            end
            if selectedKG == nil then
                selectedKG = kg
            end

            if not ESPObjects[egg] then
                createESP(egg)
            end

            if ESPObjects[egg] then
                local data = ESPObjects[egg]
                local position = getEggPosition(egg)
                if position and data.Part then
                    data.Part.Position = position
                end
                if data.Label then
                    data.Label.Text = selectedName .. " | " .. tostring(weight)
                end
            end

            activeEggSet[egg] = true
        end
    end

    for egg, data in pairs(ESPObjects) do
        if not activeEggSet[egg] then
            if data.Part then
                pcall(function()
                    data.Part:Destroy()
                end)
            end
            ESPObjects[egg] = nil
        end
    end

