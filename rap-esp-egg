local function AddDebug(text)
    table.insert(DebugLines, tostring(text))

    if #DebugLines > 150 then
        table.remove(DebugLines, 1)
    end

    DebugText.Text = table.concat(DebugLines, "\n")

    task.defer(function()
        DebugBox.CanvasSize = UDim2.fromOffset(
            0,
            DebugText.TextBounds.Y + 15
        )

        DebugBox.CanvasPosition = Vector2.new(
            0,
            math.max(0, DebugText.TextBounds.Y - DebugBox.AbsoluteSize.Y)
        )
    end)
end

