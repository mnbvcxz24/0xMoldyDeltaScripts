local EggTypes = {
    "All Eggs",
    "White Egg",
    "Blackhole Egg",
    "Solaris Egg",
    "Cherub Egg",
    "Volcanic Egg"
}

local SelectedEggs = {
    ["All Eggs"] = true
}

local FilterButtons = {}

local function updateFilterText()
    if SelectedEggs["All Eggs"] then
        FilterButton.Text = "All Eggs ▼"
        return
    end

    local selected = {}

    for _, eggName in ipairs(EggTypes) do
        if eggName ~= "All Eggs" and SelectedEggs[eggName] then
            table.insert(selected, eggName)
        end
    end

    if #selected == 0 then
        SelectedEggs["All Eggs"] = true
        FilterButton.Text = "All Eggs ▼"
    elseif #selected == 1 then
        FilterButton.Text = selected[1] .. " ▼"
    else
        FilterButton.Text = tostring(#selected) .. " Eggs Selected ▼"
    end
end

local function createFilterOption(eggName, index)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -10, 0, 23)
    button.Position = UDim2.fromOffset(5, 5 + ((index - 1) * 24))
    button.BackgroundTransparency = 1
    button.TextColor3 = Color3.fromRGB(210, 210, 218)
    button.TextSize = 11
    button.Font = Enum.Font.Gotham
    button.TextXAlignment = Enum.TextXAlignment.Left
    button.AutoButtonColor = false
    button.ZIndex = 11
    button.Parent = FilterFrame

    FilterButtons[eggName] = button

    local function updateButton()
        if SelectedEggs[eggName] then
            button.Text = "☑ " .. eggName
            button.TextColor3 = Color3.fromRGB(100, 200, 130)
        else
            button.Text = "☐ " .. eggName
            button.TextColor3 = Color3.fromRGB(190, 190, 198)
        end
    end

    updateButton()

    button.MouseButton1Click:Connect(function()
        if eggName == "All Eggs" then
            SelectedEggs = {
                ["All Eggs"] = true
            }
        else
            SelectedEggs["All Eggs"] = nil

            if SelectedEggs[eggName] then
                SelectedEggs[eggName] = nil
            else
                SelectedEggs[eggName] = true
            end
        end

        for name, filterButton in pairs(FilterButtons) do
            if SelectedEggs[name] then
                filterButton.Text = "☑ " .. name
                filterButton.TextColor3 = Color3.fromRGB(100, 200, 130)
            else
                filterButton.Text = "☐ " .. name
                filterButton.TextColor3 = Color3.fromRGB(190, 190, 198)
            end
        end

        updateFilterText()
    end)
end

for index, eggName in ipairs(EggTypes) do
    createFilterOption(eggName, index)
end

