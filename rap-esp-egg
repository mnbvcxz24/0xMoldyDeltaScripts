}

local SelectedEggs = {}
local FilterButtons = {}

local function updateFilterText()
    local selectedName

    for name in pairs(SelectedEggs) do
        selectedName = name
        break
    end

    FilterButton.Text = (selectedName or "--") .. " ▼"

    if selectedName then
        FilterCount.Text = selectedName .. ": 0"
    else
        FilterCount.Text = "Selected Eggs: 0"
    end
end

local function refreshFilterButtons()
    for name, button in pairs(FilterButtons) do
        if SelectedEggs[name] then
            button.Text = "☑ " .. name
            button.TextColor3 = Color3.fromRGB(100, 200, 130)
        else
            button.Text = "☐ " .. name
            button.TextColor3 = Color3.fromRGB(190, 190, 198)
        end
    end
end

local function createFilterOption(eggName, index)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -10, 0, 23)
    button.Position = UDim2.fromOffset(5, 5 + ((index - 1) * 24))
    button.BackgroundTransparency = 1
    button.TextColor3 = Color3.fromRGB(190, 190, 198)
    button.TextSize = 11
    button.Font = Enum.Font.Gotham
    button.TextXAlignment = Enum.TextXAlignment.Left
    button.AutoButtonColor = false
    button.ZIndex = 21
    button.Parent = FilterFrame

    FilterButtons[eggName] = button

    button.MouseButton1Click:Connect(function()
        if eggName == "--" then
            SelectedEggs = {}
        else
            SelectedEggs = {
                [eggName] = true
            }
        end

        refreshFilterButtons()
        updateFilterText()
        FilterFrame.Visible = false
    end)

    button.Text = "☐ " .. eggName
end

for index, eggName in ipairs(EggTypes) do
    createFilterOption(eggName, index)
end

