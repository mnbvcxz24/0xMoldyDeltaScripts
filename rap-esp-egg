local Rayfield = loadstring(game:HttpGet("https://sirius.menu/gen2"))()

local Window = Rayfield:CreateWindow({
    Name = "ESP",
    Subtitle = "Egg ESP",
    Size = UDim2.fromOffset(400, 300),
    MinimizeButton = true,
})

local MainTab = Window:CreateTab({
    name = "ESP",
    icon = 93364949241311,
})

local ESPEnabled = false

MainTab:CreateToggle({
    name = "Egg ESP",
    flag = "EggESP",
    callback = function(value)
        ESPEnabled = value
    end,
})

MainTab:CreateButton({
    Name = "Scan Active Eggs",
    Callback = function()
        local ReplicatedStorage = game:GetService("ReplicatedStorage")
        local ServerData = ReplicatedStorage:FindFirstChild("ServerData")

        if not ServerData then
            return
        end

        local ActiveEggs = ServerData:FindFirstChild("ActiveEggs")

        if not ActiveEggs then
            return
        end

        local count = 0

        for _, egg in ipairs(ActiveEggs:GetChildren()) do
            count = count + 1

            local galaxy = egg:FindFirstChild("Galaxy")
            local galaxyValue = "N/A"

            if galaxy then
                if galaxy:IsA("ValueBase") then
                    galaxyValue = tostring(galaxy.Value)
                else
                    galaxyValue = galaxy.ClassName
                end
            end

            warn(
                "EGG:",
                egg.Name,
                "| Galaxy:",
                galaxyValue,
                "| Class:",
                egg.ClassName
            )
        end

        Rayfield:Notify({
            Title = "Egg Scan",
            Content = "Found " .. tostring(count) .. " active eggs.",
            Duration = 3
        })
    end,
})
