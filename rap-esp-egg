local ESPFolder = Instance.new("Folder")
ESPFolder.Name = "EggESP"
ESPFolder.Parent = workspace

local ESPObjects = {}

local function clearESP()
    for egg, data in pairs(ESPObjects) do
        if data.Part then
            pcall(function()
                data.Part:Destroy()
            end)
        end

        ESPObjects[egg] = nil
    end
end

local function getEggPosition(egg)
    local position = egg:GetAttribute("Position")

    AddDebug(
        "[POSITION] " ..
        egg:GetAttribute("Egg") .. 
        " | Type: " .. 
        typeof(position) ..
        " | Value: " ..
        tostring(position)
    )

    if typeof(position) == "Vector3" then
        return position
    end

    if typeof(position) == "CFrame" then
        return position.Position
    end

    return nil
end

local function createESP(egg)
    if ESPObjects[egg] then
        return
    end

    local eggName = egg:GetAttribute("Egg") or "Egg"
    local position = getEggPosition(egg)

    if not position then
        AddDebug("[ESP ERROR] No usable Position for " .. tostring(eggName))
        return
    end

    local part = Instance.new("Part")
    part.Name = "EggESP_" .. egg.Name
    part.Size = Vector3.new(0.5, 0.5, 0.5)
    part.Position = position
    part.Anchored = true
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.Transparency = 1
    part.Parent = ESPFolder

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "EggLabel"
    billboard.Size = UDim2.fromOffset(180, 50)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = 1000
    billboard.Parent = part

    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.Text = eggName
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextStrokeTransparency = 0
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.TextSize = 13
    label.Font = Enum.Font.GothamBold
    label.Parent = billboard

    ESPObjects[egg] = {
        Part = part,
        Label = label
    }

    AddDebug("[ESP] Created: " .. tostring(eggName))
end

local function updateESP()
    clearESP()

    if Toggle.Text ~= "ON" then
        return
    end

    local selectedName

    for name in pairs(SelectedEggs) do
        selectedName = name
        break
    end

    if not selectedName then
        AddDebug("[ESP] No egg selected")
        return
    end

    local ServerData = ReplicatedStorage:FindFirstChild("ServerData")

    if not ServerData then
        AddDebug("[ESP ERROR] ServerData not found")
        return
    end

    local ActiveEggs = ServerData:FindFirstChild("ActiveEggs")

    if not ActiveEggs then
        AddDebug("[ESP ERROR] ActiveEggs not found")
        return
    end

    local total = 0

    for _, egg in ipairs(ActiveEggs:GetChildren()) do
        if egg:GetAttribute("Egg") == selectedName then
            total += 1
            createESP(egg)
        end
    end

    FilterCount.Text = selectedName .. ": " .. tostring(total)
end

ScanButton.MouseButton1Click:Connect(function()
    DebugLines = {}
    DebugText.Text = ""
    DebugBox.CanvasPosition = Vector2.new(0, 0)

    AddDebug("========== EGG SCAN ==========")

    local success, err = pcall(function()
        local ServerData = ReplicatedStorage:FindFirstChild("ServerData")

        if not ServerData then
            AddDebug("[ERROR] ServerData not found")
            return
        end

        local ActiveEggs = ServerData:FindFirstChild("ActiveEggs")

        if not ActiveEggs then
            AddDebug("[ERROR] ActiveEggs not found")
            return
        end

        local eggs = ActiveEggs:GetChildren()

        EggCount.Text = "Active Eggs: " .. tostring(#eggs)

        local selectedName

        for name in pairs(SelectedEggs) do
            selectedName = name
            break
        end

        AddDebug("Total Active Eggs: " .. tostring(#eggs))
        AddDebug("Filter: " .. tostring(selectedName or "--"))

        if not selectedName then
            FilterCount.Text = "Selected Eggs: 0"
            AddDebug("No egg selected")
            AddDebug("========== SCAN COMPLETE ==========")
            return
        end

        local count = 0

        for _, egg in ipairs(eggs) do
            if egg:GetAttribute("Egg") == selectedName then
                count += 1

                local position = egg:GetAttribute("Position")

                AddDebug(
                    tostring(count) ..
                    ". " ..
                    tostring(egg:GetAttribute("Egg")) ..
                    " | Position Type: " ..
                    typeof(position)
                )
            end
        end

        FilterCount.Text = selectedName .. ": " .. tostring(count)

        AddDebug("Selected Eggs: " .. tostring(count))
        AddDebug("========== SCAN COMPLETE ==========")
    end)

    if not success then
        AddDebug("========== LUA ERROR ==========")
        AddDebug(tostring(err))
    end
end)

Toggle.MouseButton1Click:Connect(function()
    local enabled = Toggle.Text == "OFF"

    Toggle.Text = enabled and "ON" or "OFF"

    Toggle.BackgroundColor3 = enabled
        and Color3.fromRGB(55, 120, 75)
        or Color3.fromRGB(45, 45, 53)

    Status.Text = enabled
        and "ESP Status: Enabled"
        or "ESP Status: Disabled"

    if enabled then
        AddDebug("[ESP] Enabled")
        updateESP()
    else
        AddDebug("[ESP] Disabled")
        clearESP()
    end
end)

task.spawn(function()
    while Gui.Parent do
        if Toggle.Text == "ON" then
            pcall(updateESP)
        end

        task.wait(1)
    end
end)

