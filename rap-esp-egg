local Rayfield = loadstring(game:HttpGet("https://sirius.menu/gen2"))()

local Window = Rayfield:CreateWindow({
    Name = "ESP",
    Subtitle = "Egg ESP",
    Size = UDim2.fromOffset(400, 300),
    MinimizeButton = true,
})

local MainTab = Window:CreateTab({
    name = "ESP",
    icon = 93364949241311,
})

local ESPEnabled = false

MainTab:CreateToggle({
    name = "Egg ESP",
    flag = "EggESP",
    callback = function(value)
        ESPEnabled = value
    end,
})

MainTab:CreateButton({
    Name = "Scan Active Eggs",
    Callback = function()
        local ReplicatedStorage = game:GetService("ReplicatedStorage")
        local ServerData = ReplicatedStorage:FindFirstChild("ServerData")
        local ActiveEggs = ServerData and ServerData:FindFirstChild("ActiveEggs")

        if not ActiveEggs then
            Rayfield:Notify({
                Title = "Egg Scan",
                Content = "ActiveEggs not found.",
                Duration = 3
            })
            return
        end

        local count = 0

        for _, egg in ipairs(ActiveEggs:GetChildren()) do
            count += 1

            warn("========== EGG ==========")
            warn("Name:", egg.Name)
            warn("Class:", egg.ClassName)

            for _, descendant in ipairs(egg:GetDescendants()) do
                local value

                if descendant:IsA("ValueBase") then
                    value = descendant.Value
                else
                    value = "-"
                end

                warn(
                    "Path:",
                    descendant:GetFullName(),
                    "| Class:",
                    descendant.ClassName,
                    "| Value:",
                    tostring(value)
                )
            end
        end

        Rayfield:Notify({
            Title = "Egg Scan",
            Content = "Found " .. tostring(count) .. " active eggs.",
            Duration = 3
        })
    end,
})
