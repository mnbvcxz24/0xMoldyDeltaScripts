local function rebuildFilter()
    for _, child in ipairs(FilterFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    table.clear(FilterButtons)

    for index, eggName in ipairs(EggTypes) do
        local button = Instance.new("TextButton")

        button.Size = UDim2.new(1, -10, 0, 22)

        button.Position = UDim2.fromOffset(
            5,
            5 + ((index - 1) * 22)
        )

        button.BackgroundTransparency = 1
        button.TextColor3 = Color3.fromRGB(190, 190, 198)
        button.TextSize = textSize(10)
        button.Font = Enum.Font.Gotham
        button.TextXAlignment = Enum.TextXAlignment.Left
        button.AutoButtonColor = false
        button.ZIndex = 21
        button.Parent = FilterFrame

        FilterButtons[eggName] = button

        if SelectedEggs[eggName] then
            button.Text = "☑ " .. eggName
            button.TextColor3 = Color3.fromRGB(100, 200, 130)
        else
            button.Text = "☐ " .. eggName
        end

        button.MouseButton1Click:Connect(function()
            if eggName == "--" then
                SelectedEggs = {}
            else
                if SelectedEggs[eggName] then
                    SelectedEggs[eggName] = nil
                else
                    SelectedEggs[eggName] = true
                end
            end
        
            refreshFilterButtons()
            updateFilterText()
            saveConfig()
        
            FilterFrame.Visible = true
        
            if Toggle.Text == "ON" then
                updateESP()
            end
        end)
    end

    FilterFrame.CanvasPosition = Vector2.new(0, 0)
end

