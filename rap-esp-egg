local dragging = false
local dragStart
local startPos

Header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        dragging = true
        dragStart = input.Position
        startPos = Main.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        local delta = input.Position - dragStart

        Main.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

local function showPage(page, title)
    ESPPage.Visible = false
    DebugPage.Visible = false
    SettingsPage.Visible = false

    page.Visible = true
end

ESPButton.MouseButton1Click:Connect(function()
    showPage(ESPPage, "ESP")
end)

DebugButton.MouseButton1Click:Connect(function()
    showPage(DebugPage, "Debug")
end)

SettingsButton.MouseButton1Click:Connect(function()
    showPage(SettingsPage, "Settings")
end)

Toggle.MouseButton1Click:Connect(function()
    local enabled = Toggle.Text == "OFF"

    Toggle.Text = enabled and "ON" or "OFF"
    Toggle.BackgroundColor3 = enabled
        and Color3.fromRGB(55, 120, 75)
        or Color3.fromRGB(45, 45, 53)

    Status.Text = enabled
        and "ESP Status: Enabled"
        or "ESP Status: Disabled"
end)

