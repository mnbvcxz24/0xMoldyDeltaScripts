local Rayfield = loadstring(game:HttpGet("https://sirius.menu/gen2"))()

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ActiveEggs = ReplicatedStorage
    :WaitForChild("ServerData")
    :WaitForChild("ActiveEggs")

local Window = Rayfield:CreateWindow({
    name = "Egg ESP",
    subtitle = "Active Eggs",
    sidebarLayout = true,
})

local ESPTab = Window:CreateTab({
    name = "ESP",
    icon = 93364949241311,
})

ESPTab:CreateToggle({
    name = "Egg ESP",
    flag = "EggESP",
    callback = function(value)
        print("Egg ESP:", value)
    end,
})

ESPTab:CreateButton({
    name = "Scan Active Eggs",
    callback = function()
        for _, egg in ipairs(ActiveEggs:GetChildren()) do
            local eggName = egg:GetAttribute("Egg")
            local position = egg:GetAttribute("Position")

            if eggName and position then
                print(eggName, position)
            end
        end
    end,
})
