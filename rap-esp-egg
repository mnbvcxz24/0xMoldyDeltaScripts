local CONFIG_FOLDER = "RAP"
local CONFIG_FILE = CONFIG_FOLDER .. "/rap_esp_egg_config.json"

local function saveConfig()
    if not writefile then
        AddDebug("[CONFIG] writefile unavailable")
        return
    end

    pcall(function()
        if not isfolder(CONFIG_FOLDER) then
            makefolder(CONFIG_FOLDER)
        end

        local selected = {}

        for eggName in pairs(SelectedEggs) do
            table.insert(selected, eggName)
        end

        writefile(
            CONFIG_FILE,
            game:GetService("HttpService"):JSONEncode({
                selectedEggs = selected
            })
        )

        AddDebug("[CONFIG] Saved " .. tostring(#selected) .. " selected eggs")
    end)
end

local function loadConfig()
    if not isfile or not isfile(CONFIG_FILE) then
        return
    end

    local success, data = pcall(function()
        return game:GetService("HttpService"):JSONDecode(
            readfile(CONFIG_FILE)
        )
    end)

    if not success or type(data) ~= "table" then
        return
    end

    SelectedEggs = {}

    if type(data.selectedEggs) == "table" then
        for _, eggName in ipairs(data.selectedEggs) do
            if type(eggName) == "string" and eggName ~= "--" then
                SelectedEggs[eggName] = true
            end
        end
    end

    AddDebug("[CONFIG] Loaded " .. tostring(#data.selectedEggs or 0) .. " selected eggs")
end

