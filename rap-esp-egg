ScanButton.MouseButton1Click:Connect(function()
    DebugLines = {}
    DebugText.Text = ""
    DebugBox.CanvasPosition = Vector2.new(0, 0)

    AddDebug("========== EGG SCAN ==========")

    local success, err = pcall(function()
        local ReplicatedStorage = game:GetService("ReplicatedStorage")
        local ServerData = ReplicatedStorage:FindFirstChild("ServerData")

        if not ServerData then
            AddDebug("[ERROR] ServerData not found")
            return
        end

        local ActiveEggs = ServerData:FindFirstChild("ActiveEggs")

        if not ActiveEggs then
            AddDebug("[ERROR] ActiveEggs not found")
            return
        end

        local eggs = ActiveEggs:GetChildren()

        local selectedName

        for name in pairs(SelectedEggs) do
            selectedName = name
            break
        end

        AddDebug("Total Active Eggs: " .. tostring(#eggs))

        if selectedName == "All Eggs" then
            AddDebug("Filter: All Eggs")
            AddDebug("Eggs Found: " .. tostring(#eggs))
        else
            AddDebug("Filter: " .. selectedName)

            local searchName = selectedName:gsub(" Egg$", ""):lower()
            local count = 0

            for _, egg in ipairs(eggs) do
                if egg.Name:lower():find(searchName, 1, true) then
                    count += 1
                end
            end

            AddDebug(selectedName .. " Found: " .. tostring(count))
        end

        AddDebug("")
        AddDebug("========== SCAN COMPLETE ==========")
    end)

    if not success then
        AddDebug("========== LUA ERROR ==========")
        AddDebug(tostring(err))
    end
end)

