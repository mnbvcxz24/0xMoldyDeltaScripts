local function getRanchLuckText()
    local playerGui = player:FindFirstChild("PlayerGui")
    if not playerGui then
        return nil
    end

    local upgrade = playerGui:FindFirstChild("Upgrade")
    if not upgrade then
        return nil
    end

    local currentUpgrade = upgrade:FindFirstChild("CurrentUpgrade")
    if not currentUpgrade then
        return nil
    end

    return currentUpgrade.Text
end

local function parseLuck(value)
    if not value then
        return nil
    end

    value = tostring(value)
        :upper()
        :gsub(",", "")
        :gsub("%s+", "")
        :gsub("X", "")

    local number, suffix = value:match("^([%d%.]+)([KMBT]?)$")

    number = tonumber(number)

    if not number then
        return nil
    end

    local multipliers = {
        K = 1000,
        M = 1000000,
        B = 1000000000,
        T = 1000000000000
    }

    return number * (multipliers[suffix] or 1)
end

local function getRanchLuck()
    return parseLuck(getRanchLuckText())
end

local function getEggLuckText(eggName)
    if not eggName or eggName == "--" then
        return nil
    end

    local playerGui = player:FindFirstChild("PlayerGui")
    if not playerGui then
        return nil
    end

    local main = playerGui:FindFirstChild("Main")
    if not main then
        return nil
    end

    local eggTracker = main:FindFirstChild("EggTracker")
    if not eggTracker then
        return nil
    end

    local eggsHolder = eggTracker:FindFirstChild("EggsHolder")
    if not eggsHolder then
        return nil
    end

    local eggFrame = eggsHolder:FindFirstChild(eggName)
    if not eggFrame then
        return nil
    end

    local luckDisplay = eggFrame:FindFirstChild("LuckDisplay")
    if not luckDisplay then
        return nil
    end

    local luck = luckDisplay:FindFirstChild("Luck")
    if not luck then
        return nil
    end

    return luck.Text
end

local function getEggLuck(eggName)
    return parseLuck(getEggLuckText(eggName))
end

local function calculateKG(weight, eggLuck, ranchLuck)
    weight = tonumber(weight)
    eggLuck = tonumber(eggLuck)
    ranchLuck = tonumber(ranchLuck)

    if not weight or not eggLuck or not ranchLuck then
        return nil
    end

    return weight * ((eggLuck * ranchLuck) ^ (1 / 3)) * 0.1272
end

local function getActiveEggs()
    local ServerData = ReplicatedStorage:FindFirstChild("ServerData")

    if not ServerData then
        return nil
    end

    return ServerData:FindFirstChild("ActiveEggs")
end

local function updateFilterText()
    local selectedName

    for name in pairs(SelectedEggs) do
        selectedName = name
        break
    end

    FilterButton.Text = (selectedName or "--") .. " ▼"

    if selectedName then
        FilterCount.Text = selectedName .. ": 0"

        local ActiveEggs = getActiveEggs()
        local weightFound = false

        if ActiveEggs then
            for _, egg in ipairs(ActiveEggs:GetChildren()) do
                if egg:GetAttribute("Egg") == selectedName then
                    local weight = egg:GetAttribute("Weight")

                    if weight ~= nil then
                        WeightLabel.Text = "Weight: " .. tostring(weight) .. " kg"
                        weightFound = true
                        break
                    end
                end
            end
        end

        if not weightFound then
            WeightLabel.Text = "Weight: --"
        end

        local eggLuck = getEggLuck(selectedName)
        local ranchLuck = getRanchLuck()
        local calculatedKG

        if weightFound then
            local weight = tonumber(string.match(WeightLabel.Text, "([%d%.]+)"))
            calculatedKG = calculateKG(weight, eggLuck, ranchLuck)
        end

        KGLabel.Text = "Calculated KG: " .. formatKG(calculatedKG)
    else
        FilterCount.Text = "Selected Eggs: 0"
        WeightLabel.Text = "Weight: --"
        KGLabel.Text = "Calculated KG: --"
    end
end

