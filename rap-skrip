local CONFIG_FOLDER = "RAPSkrip"
local CONFIG_FILE = CONFIG_FOLDER .. "/rap_skrip_config.json"

local function saveConfig()
    if not writefile then
        AddDebug("[CONFIG] writefile unavailable")
        return
    end

    local success, err = pcall(function()
        if makefolder and isfolder and not isfolder(CONFIG_FOLDER) then
            makefolder(CONFIG_FOLDER)
        end

        local selected = {}

        for eggName in pairs(SelectedEggs) do
            table.insert(selected, eggName)
        end

        table.sort(selected)

        writefile(
            CONFIG_FILE,
            HttpService:JSONEncode({
                selectedEggs = selected
            })
        )

        AddDebug("[CONFIG] Saved " .. tostring(#selected) .. " selected eggs")
    end)

    if not success then
        AddDebug("[CONFIG ERROR] " .. tostring(err))
    end
end

local function loadConfig()
    if not isfile or not readfile then
        AddDebug("[CONFIG] File functions unavailable")
        return
    end

    local exists = false

    local checkSuccess = pcall(function()
        exists = isfile(CONFIG_FILE)
    end)

    if not checkSuccess or not exists then
        AddDebug("[CONFIG] No saved config")
        return
    end

    local success, data = pcall(function()
        return HttpService:JSONDecode(
            readfile(CONFIG_FILE)
        )
    end)

    if not success or type(data) ~= "table" then
        AddDebug("[CONFIG] Invalid config")
        return
    end

    SelectedEggs = {}

    local count = 0

    if type(data.selectedEggs) == "table" then
        for _, eggName in ipairs(data.selectedEggs) do
            if type(eggName) == "string" and eggName ~= "--" then
                SelectedEggs[eggName] = true
                count = count + 1
            end
        end
    end

    AddDebug("[CONFIG] Loaded " .. tostring(count) .. " selected eggs")
end

local function getRanchLuckText()
    local playerGui = player:FindFirstChild("PlayerGui")

    if not playerGui then
        return nil
    end

    local upgrade = playerGui:FindFirstChild("Upgrade")

    if not upgrade then
        return nil
    end

    local currentUpgrade = upgrade:FindFirstChild("CurrentUpgrade")

    if not currentUpgrade then
        return nil
    end

    return currentUpgrade.Text
end

local function parseLuck(value)
    if not value then
        return nil
    end

    value = tostring(value)
        :upper()
        :gsub(",", "")
        :gsub("%s+", "")
        :gsub("X", "")

    local number, suffix = value:match("^([%d%.]+)([KMBT]?)$")

    number = tonumber(number)

    if not number then
        return nil
    end

    local multipliers = {
        K = 1000,
        M = 1000000,
        B = 1000000000,
        T = 1000000000000
    }

    return number * (multipliers[suffix] or 1)
end

local function getRanchLuck()
    return parseLuck(getRanchLuckText())
end

local function getEggLuckText(eggName)
    if not eggName or eggName == "--" then
        return nil
    end

    local playerGui = player:FindFirstChild("PlayerGui")

    if not playerGui then
        return nil
    end

    local main = playerGui:FindFirstChild("Main")

    if not main then
        return nil
    end

    local eggTracker = main:FindFirstChild("EggTracker")

    if not eggTracker then
        return nil
    end

    local eggsHolder = eggTracker:FindFirstChild("EggsHolder")

    if not eggsHolder then
        return nil
    end

    local eggFrame = eggsHolder:FindFirstChild(eggName)

    if not eggFrame then
        return nil
    end

    local luckDisplay = eggFrame:FindFirstChild("LuckDisplay")

    if not luckDisplay then
        return nil
    end

    local luck = luckDisplay:FindFirstChild("Luck")

    if not luck then
        return nil
    end

    return luck.Text
end

local function getEggLuck(eggName)
    return parseLuck(getEggLuckText(eggName))
end

local function calculateKG(weight, eggLuck, ranchLuck)
    weight = tonumber(weight)
    eggLuck = tonumber(eggLuck)
    ranchLuck = tonumber(ranchLuck)

    if not weight or not eggLuck or not ranchLuck then
        return nil
    end

    return weight * ((eggLuck * ranchLuck) ^ (1 / 3)) * 0.1272
end

local function getActiveEggs()
    local ServerData = ReplicatedStorage:FindFirstChild("ServerData")

    if not ServerData then
        return nil
    end

    return ServerData:FindFirstChild("ActiveEggs")
end

local function getEggUUID(egg)
    if not egg then
        return nil
    end

    local uuid = egg:GetAttribute("UUID")

    if uuid == nil then
        uuid = egg:GetAttribute("Uuid")
    end

    if uuid == nil then
        uuid = egg:GetAttribute("Id")
    end

    if uuid == nil then
        uuid = egg:GetAttribute("ID")
    end

    if uuid == nil then
        uuid = egg.Name
    end

    if typeof(uuid) ~= "string" then
        uuid = tostring(uuid)
    end

    if uuid == "" then
        return nil
    end

    return uuid
end

local function isAutoPickupEggSelected(eggName)
    return AutoSelectedEggs[eggName] == true
end

local function tryAutoPickup()
    if not AutoPickupRunning then
        return
    end

    if not EggPickupEvent then
        AddDebug("[AUTO ERROR] EggPickup remote not found")
        return
    end

    local ActiveEggs = getActiveEggs()

    if not ActiveEggs then
        AddDebug("[AUTO ERROR] ActiveEggs not found")
        return
    end

    for _, egg in ipairs(ActiveEggs:GetChildren()) do
        if not AutoPickupRunning then
            break
        end

        local eggName = egg:GetAttribute("Egg")

        if eggName and isAutoPickupEggSelected(eggName) then
            local uuid = getEggUUID(egg)

            if uuid and not AutoPickupClaimed[uuid] then
                AutoPickupClaimed[uuid] = true

                AddDebug(
                    "[AUTO] Target: " ..
                    tostring(eggName)
                )

                AddDebug(
                    "[AUTO] UUID: " ..
                    tostring(uuid)
                )

                AddDebug(
                    "[AUTO] Distance: Unlimited"
                )

                local success, err = pcall(function()
                    EggPickupEvent:FireServer(uuid)
                end)

                if success then
                    AddDebug(
                        "[AUTO] Pickup request sent: " ..
                        tostring(eggName)
                    )
                else
                    AutoPickupClaimed[uuid] = nil

                    AddDebug(
                        "[AUTO ERROR] Pickup failed: " ..
                        tostring(err)
                    )
                end

                return egg, uuid
            end
        end
    end

    return nil
end

local function getSelectedEggNames()
    local names = {}

    for _, eggName in ipairs(EggTypes) do
        if eggName ~= "--" and SelectedEggs[eggName] then
            table.insert(names, eggName)
        end
    end

    return names
end

local function getPrimarySelectedEgg()
    local names = getSelectedEggNames()
    return names[1]
end

local function updateFilterText()
    local selectedNames = getSelectedEggNames()

    if #selectedNames == 0 then
        FilterButton.Text = "-- ▼"
        FilterCount.Text = "Detected eggs: 0"
        return
    end

    if #selectedNames == 1 then
        FilterButton.Text = selectedNames[1] .. " ▼"
    else
        FilterButton.Text =
            tostring(#selectedNames) ..
            " eggs selected ▼"
    end

    local ActiveEggs = getActiveEggs()

    if not ActiveEggs then
        FilterCount.Text = "Detected eggs: 0"
        return
    end

    local lines = {}
    local counts = {}

    for _, eggName in ipairs(selectedNames) do
        counts[eggName] = 0
    end

    for _, egg in ipairs(ActiveEggs:GetChildren()) do
        local eggName = egg:GetAttribute("Egg")

        if eggName and SelectedEggs[eggName] then
            counts[eggName] =
                (counts[eggName] or 0) + 1
        end
    end

    local total = 0

    for _, eggName in ipairs(selectedNames) do
        local count = counts[eggName] or 0

        if count > 0 then
            total = total + count

            for _, egg in ipairs(ActiveEggs:GetChildren()) do
                if egg:GetAttribute("Egg") == eggName then
                    local weight =
                        tonumber(
                            egg:GetAttribute("Weight")
                        )

                    if weight then
                        table.insert(
                            lines,
                            string.format(
                                "%s - %.2f",
                                eggName,
                                weight
                            )
                        )
                    else
                        table.insert(
                            lines,
                            eggName .. " - --"
                        )
                    end
                end
            end
        end
    end

    FilterCount.Text =
        "Detected eggs: " ..
        tostring(total)

    if #lines > 0 then
        FilterCount.Text =
            FilterCount.Text ..
            "\n" ..
            table.concat(lines, "\n")
    end
end

