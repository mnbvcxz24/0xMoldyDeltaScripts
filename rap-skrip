local function refreshAutoFilterText()
    local selected = {}

    for eggName, enabled in pairs(AutoSelectedEggs) do
        if enabled then
            table.insert(selected, eggName)
        end
    end

    table.sort(selected)

    if #selected == 0 then
        AutoFilterButton.Text = "-- ▼"
    else
        AutoFilterButton.Text = table.concat(selected, ", ") .. " ▼"
    end
end

local function createAutoFilterButtons()
    for _, button in pairs(AutoFilterButtons) do
        if button then
            button:Destroy()
        end
    end

    table.clear(AutoFilterButtons)

    local y = 5

    for _, eggName in ipairs(EggTypes) do
        if eggName ~= "--" then
            local button = Instance.new("TextButton")
            button.Size = UDim2.new(1, -10, 0, 28)
            button.Position = UDim2.fromOffset(5, y)
            button.BackgroundColor3 = AutoSelectedEggs[eggName]
