                or Color3.fromRGB(38, 38, 45)
            button.BorderSizePixel = 0
            button.Text = (AutoSelectedEggs[eggName] and "✓ " or "") .. eggName
            button.TextColor3 = Color3.fromRGB(225, 225, 230)
            button.TextSize = textSize(11)
            button.Font = Enum.Font.Gotham
            button.AutoButtonColor = false
            button.ZIndex = 31
            button.Parent = AutoFilterFrame

            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(0, 5)
            corner.Parent = button

            button.MouseButton1Click:Connect(function()
                AutoSelectedEggs[eggName] = not AutoSelectedEggs[eggName]

                button.BackgroundColor3 = AutoSelectedEggs[eggName]
                    and Color3.fromRGB(55, 85, 60)
                    or Color3.fromRGB(38, 38, 45)

                button.Text = (AutoSelectedEggs[eggName] and "✓ " or "") .. eggName

                refreshAutoFilterText()
            end)

            table.insert(AutoFilterButtons, button)

            y = y + 33
        end
    end
end

