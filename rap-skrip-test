local function updateFilterText()
    local selectedNames = getSelectedEggNames()
    if #selectedNames == 0 then
        FilterButton.Text = "-- ▼"
        FilterCount.Text = "Detected eggs: 0"
        return
    end
    if #selectedNames == 1 then FilterButton.Text = selectedNames[1] .. " ▼" else FilterButton.Text = tostring(#selectedNames) .. " eggs selected ▼" end
    local ActiveEggs = getActiveEggs()
    if not ActiveEggs then FilterCount.Text = "Detected eggs: 0" return end
    local counts = {}
    for _, eggName in ipairs(selectedNames) do counts[eggName] = 0 end
    for _, egg in ipairs(ActiveEggs:GetChildren()) do
        local eggName = egg:GetAttribute("Egg")
        if eggName and SelectedEggs[eggName] then counts[eggName] = (counts[eggName] or 0) + 1 end
    end
    local lines = {}
    local total = 0
    for _, eggName in ipairs(selectedNames) do
        local count = counts[eggName] or 0
        if count > 0 then
            total = total + count
            for _, egg in ipairs(ActiveEggs:GetChildren()) do
                if egg:GetAttribute("Egg") == eggName then
                    local weight = tonumber(egg:GetAttribute("Weight"))
                    table.insert(lines, weight and string.format("%s - %.2f", eggName, weight) or eggName .. " - --")
                end
            end
        end
    end
    FilterCount.Text = "Detected eggs: " .. tostring(total)
    if #lines > 0 then FilterCount.Text = FilterCount.Text .. "\n" .. table.concat(lines, "\n") end
end

