function updateESP()
    if Toggle.Text ~= "ON" then clearESP() return end
    local selectedNames = getSelectedEggNames()
    if #selectedNames == 0 then clearESP() FilterCount.Text = "Detected eggs: 0" return end
    local ActiveEggs = getActiveEggs()
    if not ActiveEggs then clearESP() return end
    local eggs = ActiveEggs:GetChildren()
    local activeEggSet = {}
    local detectedLines = {}
    local totalSelected = 0
    for _, egg in ipairs(eggs) do
        local currentEggName = egg:GetAttribute("Egg")
        if currentEggName and SelectedEggs[currentEggName] then
            totalSelected = totalSelected + 1
            local weight = tonumber(egg:GetAttribute("Weight"))
            local position = getEggPosition(egg)
            if not ESPObjects[egg] then createESP(egg) end
            if ESPObjects[egg] then
                local data = ESPObjects[egg]
                if position and data.Part then data.Part.Position = position end
                if data.Label then data.Label.Text = tostring(currentEggName) .. " | " .. (weight and string.format("%.2f", weight) or "--") end
            end
            activeEggSet[egg] = true
            table.insert(detectedLines, tostring(currentEggName) .. " - " .. (weight and string.format("%.2f", weight) or "--"))
        end
    end
    for egg, data in pairs(ESPObjects) do
        if not activeEggSet[egg] then
            if data and data.Part then pcall(function() data.Part:Destroy() end) end
            ESPObjects[egg] = nil
        end
    end
    EggCount.Text = "Active Eggs: " .. tostring(#eggs)
    FilterCount.Text = "Detected eggs: " .. tostring(totalSelected)
    if #detectedLines > 0 then FilterCount.Text = FilterCount.Text .. "\n" .. table.concat(detectedLines, "\n") end
end

