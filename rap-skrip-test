local function getActiveEggs()
    local ServerData = ReplicatedStorage:FindFirstChild("ServerData")
    if not ServerData then return nil end
    return ServerData:FindFirstChild("ActiveEggs")
end

local function getEggPosition(egg)
    if not egg then return nil end
    local position = egg:GetAttribute("Position")
    if typeof(position) == "Vector3" then return position end
    if typeof(position) == "CFrame" then return position.Position end
    local primaryPart = egg:IsA("Model") and egg.PrimaryPart
    if primaryPart then return primaryPart.Position end
    if egg:IsA("BasePart") then return egg.Position end
    local part = egg:FindFirstChildWhichIsA("BasePart", true)
    if part then return part.Position end
    return nil
end

local function getEggUUID(egg)
    if not egg then return nil end
    local uuid = egg:GetAttribute("UUID") or egg:GetAttribute("Uuid") or egg:GetAttribute("Id") or egg:GetAttribute("ID") or egg.Name
    if uuid == nil then return nil end
    uuid = tostring(uuid)
    if uuid == "" then return nil end
    return uuid
end

local function isAutoPickupEggSelected(eggName)
    return AutoSelectedEggs[eggName] == true
end

local function getCharacterRoot()
    local character = player.Character
    if not character then return nil end
    return character:FindFirstChild("HumanoidRootPart")
end

local function findMyPlot()
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return nil end
    for _, plot in ipairs(plots:GetChildren()) do
        local data = plot:FindFirstChild("Data")
        local owner = data and data:FindFirstChild("Owner")
        if owner then
            local value = owner.Value
            if value == player then return plot end
            if value ~= nil and tostring(value) == player.Name then return plot end
            if value ~= nil and tostring(value) == player.DisplayName then return plot end
        end
    end
    return nil
end

local function getMyRanchCFrame()
    local plot = findMyPlot()
    if not plot then
        AddDebug("[AUTO ERROR] Your plot was not found")
        return nil
    end
    local baseplate = plot:FindFirstChild("Baseplate")
    if not baseplate or not baseplate:IsA("BasePart") then
        AddDebug("[AUTO ERROR] Your plot Baseplate was not found")
        return nil
    end
    return baseplate.CFrame * CFrame.new(0, (baseplate.Size.Y / 2) + 3, 0), plot, baseplate
end

local function manualTeleportToPosition(positionCFrame)
    local root = getCharacterRoot()
    if not root then
        AddDebug("[AUTO ERROR] HumanoidRootPart not found")
        return false
    end
    local success, err = pcall(function()
        root.CFrame = positionCFrame
    end)
    if not success then
        AddDebug("[AUTO ERROR] Manual teleport failed: " .. tostring(err))
        return false
    end
    return true
end

local function teleportToEgg(egg)
    if AutoPickupMovementMode ~= "Teleport" then
        AddDebug("[AUTO ERROR] Unsupported movement mode")
        return false
    end
    local position = getEggPosition(egg)
    if not position then
        AddDebug("[AUTO ERROR] Egg has no usable Position")
        return false
    end
    if not manualTeleportToPosition(CFrame.new(position + Vector3.new(0, 3, 0))) then return false end
    AddDebug("[AUTO] Teleported to " .. tostring(egg:GetAttribute("Egg")))
    return true
end

local function teleportToMyRanch()
    local ranchCFrame, plot, baseplate = getMyRanchCFrame()
    if not ranchCFrame then return false end
    if not manualTeleportToPosition(ranchCFrame) then return false end
    AddDebug("[AUTO] Manual TP to ranch: " .. plot:GetFullName())
    AddDebug(string.format("[AUTO] Ranch Baseplate: %.2f, %.2f, %.2f", baseplate.Position.X, baseplate.Position.Y, baseplate.Position.Z))
    return true
end

local function findNextAutoPickupEgg()
    local ActiveEggs = getActiveEggs()
    if not ActiveEggs then
        AddDebug("[AUTO ERROR] ActiveEggs not found")
        return nil
    end
    for _, egg in ipairs(ActiveEggs:GetChildren()) do
        local eggName = egg:GetAttribute("Egg")
        if eggName and isAutoPickupEggSelected(eggName) then
            local uuid = getEggUUID(egg)
            local position = getEggPosition(egg)
            if uuid and position then return egg, uuid end
        end
    end
    return nil
end

local function waitForAutoConfirmation(kind, timeout)
    local started = os.clock()
    while AutoPickupRunning and os.clock() - started < timeout do
        if kind == "pickup" and AutoPickupPickupConfirmed then return true end
        if kind == "deposit" and AutoPickupDepositConfirmed then return true end
        task.wait(0.05)
    end
    return false
end

local function tryAutoPickup()
    if not AutoPickupRunning or AutoPickupBusy then return end
    if not EggPickupEvent then
        AddDebug("[AUTO ERROR] EggPickup remote not found")
        return
    end

    AutoPickupBusy = true
    local success, err = pcall(function()
        local egg, uuid = findNextAutoPickupEgg()
        if not egg or not uuid then
            AutoPickupBusy = false
            return
        end

        local eggName = tostring(egg:GetAttribute("Egg"))
        AutoPickupLastTarget = eggName
        AddDebug("[AUTO] Target: " .. eggName)
        AddDebug("[AUTO] UUID: " .. uuid)
        AddDebug("[AUTO] Distance: Unlimited")

        if not teleportToEgg(egg) then
            AutoPickupBusy = false
            return
        end
        if not AutoPickupRunning then
            AutoPickupBusy = false
            return
        end

        task.wait(0.15)
        AutoPickupAwaitingUUID = uuid
        AutoPickupAwaitingPickup = true
        AutoPickupPickupConfirmed = false

        local pickupSuccess, pickupErr = pcall(function()
            EggPickupEvent:FireServer(uuid)
        end)
        if not pickupSuccess then
            AutoPickupAwaitingPickup = false
            AddDebug("[AUTO ERROR] Pickup request failed: " .. tostring(pickupErr))
            AutoPickupBusy = false
            return
        end

        AddDebug("[AUTO] Pickup request sent. Waiting for PickedUp confirmation...")
        if not waitForAutoConfirmation("pickup", AutoPickupTimeout) then
            AutoPickupAwaitingPickup = false
            AddDebug("[AUTO ERROR] PickedUp confirmation timeout")
            AutoPickupBusy = false
            return
        end

        if not AutoPickupRunning then
            AutoPickupBusy = false
            return
        end

        AddDebug(string.format("[AUTO] Claim delay: %.1fs", AutoPickupClaimDelay))
        task.wait(AutoPickupClaimDelay)

        if not AutoPickupRunning then
            AutoPickupBusy = false
            return
        end

        AutoPickupAwaitingDeposit = true
        AutoPickupDepositConfirmed = false

        if not teleportToMyRanch() then
            AutoPickupAwaitingDeposit = false
            AddDebug("[AUTO ERROR] Could not manually return to ranch")
            AutoPickupBusy = false
            return
        end

        AddDebug("[AUTO] Waiting for Deposited confirmation...")
        if not waitForAutoConfirmation("deposit", AutoPickupTimeout) then
            AutoPickupAwaitingDeposit = false
            AddDebug("[AUTO ERROR] Deposited confirmation timeout")
            AutoPickupBusy = false
            return
        end

        AddDebug("[AUTO] Cycle complete: " .. tostring(eggName))
        AddDebug("[AUTO] Next egg delay: 3.0s")
        task.wait(AutoPickupNextEggDelay)
    end)

    AutoPickupAwaitingPickup = false
    AutoPickupAwaitingDeposit = false
    if not success then AddDebug("[AUTO ERROR] " .. tostring(err)) end
    AutoPickupBusy = false
end

