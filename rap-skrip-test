        Minimized.Position = UDim2.new(minimizedStartPos.X.Scale, minimizedStartPos.X.Offset + delta.X, minimizedStartPos.Y.Scale, minimizedStartPos.Y.Offset + delta.Y)
    end
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

local function showPage(page)
    AutoPage.Visible = false
    ESPPage.Visible = false
    DebugPage.Visible = false
    SettingsPage.Visible = false
    page.Visible = true
    FilterFrame.Visible = false
    AutoFilterFrame.Visible = false
end

