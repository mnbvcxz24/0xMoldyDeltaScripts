local function tryAutoPickup()
    if not AutoPickupRunning then
        return
    end

    if AutoPickupBusy then
        return
    end

    if not EggPickupEvent then
        AddDebug(
            "[AUTO ERROR] EggPickup remote not found"
        )

        return
    end

    AutoPickupBusy = true

    local success, err =
        pcall(function()

            local egg, uuid =
                findNextAutoPickupEgg()

            if not egg or not uuid then
                AutoPickupBusy = false
                return
            end

            local eggName =
                egg:GetAttribute("Egg")

            AddDebug(
                "[AUTO] Target: " ..
                tostring(eggName)
            )

            AddDebug(
                "[AUTO] UUID: " ..
                tostring(uuid)
            )

            AddDebug(
                "[AUTO] Distance: Unlimited"
            )

            if not teleportToEgg(egg) then
                AutoPickupBusy = false
                return
            end

            if not AutoPickupRunning then
                AutoPickupBusy = false
                return
            end

            task.wait(0.15)

            AutoPickupAwaitingUUID =
                tostring(uuid)

            AutoPickupAwaitingPickup =
                true

            AutoPickupPickupConfirmed =
                false

            AutoPickupAwaitingDeposit =
                false

            AutoPickupDepositConfirmed =
                false

            local pickupSuccess, pickupErr =
                pcall(function()
                    EggPickupEvent:FireServer(
                        uuid
                    )
                end)

            if not pickupSuccess then
                AutoPickupAwaitingPickup = false

                AddDebug(
                    "[AUTO ERROR] Pickup request failed: " ..
                    tostring(pickupErr)
                )

                AutoPickupBusy = false
                return
            end

            AddDebug(
                "[AUTO] Pickup request sent"
            )

            local pickedUp =
                waitForPickupConfirmation(uuid)

            if not AutoPickupRunning then
                AutoPickupAwaitingPickup = false
                AutoPickupBusy = false
                return
            end

            if not pickedUp then
                AutoPickupAwaitingPickup = false

                AddDebug(
                    "[AUTO ERROR] Pickup confirmation timeout"
                )

                AutoPickupBusy = false
                return
            end

            AddDebug(
                "[AUTO] Carrying " ..
                tostring(eggName)
            )

            AddDebug(
                string.format(
                    "[AUTO] Claim delay: %.1fs",
                    AutoPickupClaimDelay
                )
            )

            task.wait(
                AutoPickupClaimDelay
            )

            if not AutoPickupRunning then
                AutoPickupBusy = false
                return
            end

            if AutoDipEnabled then
                AddDebug(
                    "[AUTO DIP] Teleporting to volcano..."
                )

                local character =
                    game:GetService("Players").LocalPlayer.Character

                if not character then
                    AddDebug(
                        "[AUTO DIP ERROR] Character not found"
                    )

                    AutoPickupBusy = false
                    return
                end

                if not startAutoPickupFloat(
                    VolcanoDropPosition
                ) then
                    AddDebug(
                        "[AUTO DIP ERROR] Unable to float at volcano"
                    )
                
                    AutoPickupBusy = false
                    return
                end

                task.wait(0.25)

                if not AutoPickupRunning then
                    AutoPickupBusy = false
                    return
                end

                AddDebug(
                    "[AUTO DIP] Firing VolcanoDip..."
                )

                AutoDipResult = nil
                AutoDipWaitingForResult = true
                
                AutoVolcanoMessageReceived = false
                AutoVolcanoMessageText = nil
                AutoVolcanoWaitingForMessage = false

                local dipSuccess, dipErr =
                    pcall(function()
                        VolcanoDipEvent:FireServer()
                    end)

                if not dipSuccess then
                    AutoDipWaitingForResult = false

                    AddDebug(
                        "[AUTO DIP ERROR] " ..
                        tostring(dipErr)
                    )

                    AutoPickupBusy = false
                    return
                end

                AddDebug(
                    "[AUTO DIP] Waiting for result..."
                )

                local dipStart =
                    os.clock()

                while
                    AutoDipWaitingForResult
                    and AutoPickupRunning
                    and os.clock() - dipStart < 15
                do
                    task.wait(0.1)
                end

                if not AutoPickupRunning then
                    AutoDipWaitingForResult = false
                    AutoPickupBusy = false
                    return
                end

                if AutoDipWaitingForResult then
                    AutoDipWaitingForResult = false

                    AddDebug(
                        "[AUTO DIP ERROR] Result timeout"
                    )

                    AutoPickupBusy = false
                    return
                end

                if not AutoDipResult then
                    AddDebug(
                        "[AUTO DIP ERROR] No result received"
                    )
                
                    AutoPickupBusy = false
                    return
                end
                
                AddDebug(
                    "[AUTO DIP] Result received: " ..
                    tostring(AutoDipResult.Success)
                )
                
                AddDebug(
                    "[AUTO DIP] Waiting for mutation message..."
                )
                
                AutoVolcanoWaitingForMessage = true
                
                local messageStart =
                    os.clock()
                
                while
                    not AutoVolcanoMessageReceived
                    and AutoPickupRunning
                    and os.clock() - messageStart < 10
                do
                    task.wait(0.1)
                end
                
                if not AutoPickupRunning then
                    AutoDipWaitingForResult = false
                    AutoPickupBusy = false
                    return
                end

                if not AutoVolcanoMessageReceived then
                    AutoVolcanoWaitingForMessage = false
                
                    AddDebug(
                        "[AUTO DIP ERROR] Mutation message timeout"
                    )
                
                    AutoPickupBusy = false
                    return
                end
                
                AddDebug(
                    "[AUTO DIP] Mutation process completed"
                )
                
                AddDebug(
                    "[AUTO DIP] Waiting 3 seconds before returning..."
                )
                
                task.wait(3)
                
                if not AutoPickupRunning then
                    AutoPickupBusy = false
                    return
                end
                
                stopAutoPickupFloat()
                
                AddDebug(
                    "[AUTO DIP] Returning to plot..."
                )
            end

            if not teleportToMyPlot() then
                AutoPickupBusy = false
                return
            end

            if not AutoPickupRunning then
                AutoPickupBusy = false
                return
            end

            task.wait(0.15)

            AutoPickupAwaitingDeposit =
                true

            AutoPickupDepositConfirmed =
                false

            local arrivalSuccess =
                sendArrivalClaim(uuid)

            if not arrivalSuccess then
                AutoPickupAwaitingDeposit = false
                AutoPickupBusy = false
                return
            end

            AddDebug(
                "[AUTO] Waiting for Deposited..."
            )

            local deposited =
                waitForDepositConfirmation()

            if not AutoPickupRunning then
                AutoPickupAwaitingDeposit = false
                AutoPickupBusy = false
                return
            end

            if not deposited then
                AutoPickupAwaitingDeposit = false

                AddDebug(
                    "[AUTO ERROR] Deposit confirmation timeout"
                )

                AutoPickupBusy = false
                return
            end

            AutoPickupAwaitingUUID = nil
            AutoPickupAwaitingPickup = false
            AutoPickupAwaitingDeposit = false
            AutoPickupPickupConfirmed = false
            AutoPickupDepositConfirmed = false

            AddDebug(
                "[AUTO] " ..
                tostring(eggName) ..
                " deposited successfully"
            )

            AddDebug(
                "[AUTO] Next egg delay: 3.0s"
            )

            task.wait(
                AutoPickupNextEggDelay
            )
        end)

    if not success then
        AddDebug(
            "[AUTO ERROR] " ..
            tostring(err)
        )
    end

    AutoPickupAwaitingUUID = nil
    AutoPickupAwaitingPickup = false
    AutoPickupAwaitingDeposit = false
    AutoPickupPickupConfirmed = false
    AutoPickupDepositConfirmed = false

    AutoPickupBusy = false
end

