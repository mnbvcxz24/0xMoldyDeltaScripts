local function formatKG(kg)
    if not kg then
        return "--"
    end

    kg = tonumber(kg)

    if not kg then
        return "--"
    end

    if kg >= 1000000000000 then
        return string.format("%.2fT KG", kg / 1000000000000)
    elseif kg >= 1000000000 then
        return string.format("%.2fB KG", kg / 1000000000)
    elseif kg >= 1000000 then
        return string.format("%.2fM KG", kg / 1000000)
    elseif kg >= 1000 then
        return string.format("%.2fK KG", kg / 1000)
    else
        return string.format("%.2f KG", kg)
    end
end

