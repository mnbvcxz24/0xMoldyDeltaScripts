local claimDragging = false
local function updateClaimDelayFromX(x)
    local width = AutoClaimBar.AbsoluteSize.X
    if width <= 0 then return end
    local relative = math.clamp((x - AutoClaimBar.AbsolutePosition.X) / width, 0, 1)
    AutoPickupClaimDelay = math.floor((1 + relative * 4) * 10 + 0.5) / 10
    local alpha = (AutoPickupClaimDelay - 1) / 4
    AutoClaimFill.Size = UDim2.new(alpha, 0, 1, 0)
    AutoClaimKnob.Position = UDim2.new(alpha, 0, 0.5, 0)
    AutoClaimLabel.Text = string.format("Claim Delay: %.1fs", AutoPickupClaimDelay)
end

AutoClaimKnob.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then claimDragging = true end
end)
AutoClaimBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        claimDragging = true
        updateClaimDelayFromX(input.Position.X)
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if claimDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then updateClaimDelayFromX(input.Position.X) end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then claimDragging = false end
end)

