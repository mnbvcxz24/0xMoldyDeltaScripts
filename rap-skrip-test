local function updateAntiAFKButton()
    AntiAFKButton.Text =
        AntiAFKEnabled and "ON" or "OFF"

    AntiAFKButton.BackgroundColor3 =
        AntiAFKEnabled
        and Color3.fromRGB(55, 120, 75)
        or Color3.fromRGB(45, 45, 53)
end

AntiAFKButton.MouseButton1Click:Connect(function()
    AntiAFKEnabled =
        not AntiAFKEnabled

    updateAntiAFKButton()

    AddDebug(
        AntiAFKEnabled
        and "[ANTI AFK] Enabled"
        or "[ANTI AFK] Disabled"
    )
end)

