local function calculateKG(weight, eggLuck, ranchLuck)
    weight = tonumber(weight)
    eggLuck = tonumber(eggLuck)
    ranchLuck = tonumber(ranchLuck)

    if not weight or not eggLuck or not ranchLuck then
        return nil
    end

    return weight *
        ((eggLuck * ranchLuck) ^ (1 / 3)) *
        0.1272
end

