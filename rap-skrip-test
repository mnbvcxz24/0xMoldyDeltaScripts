local function parseLuck(value)
    if not value then
        return nil
    end

    value = tostring(value)
        :upper()
        :gsub(",", "")
        :gsub("%s+", "")
        :gsub("X", "")

    local number, suffix =
        value:match("^([%d%.]+)([KMBT]?)$")

    number = tonumber(number)

    if not number then
        return nil
    end

    local multipliers = {
        K = 1000,
        M = 1000000,
        B = 1000000000,
        T = 1000000000000
    }

    return number * (multipliers[suffix] or 1)
end

local function getRanchLuck()
