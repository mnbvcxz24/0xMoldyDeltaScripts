local function getSelectedEggNames()
    local names = {}

    for _, eggName in ipairs(EggTypes) do
        if eggName ~= "--"
            and SelectedEggs[eggName] then

            table.insert(
                names,
                eggName
            )
        end
    end

    return names
end

local function getPrimarySelectedEgg()
    local names =
        getSelectedEggNames()

    return names[1]
end

local function updateFilterText()
    local selectedNames =
        getSelectedEggNames()

    if #selectedNames == 0 then
        FilterButton.Text = "-- ▼"
        FilterCount.Text =
            "Detected eggs: 0"

        return
    end

    if #selectedNames == 1 then
        FilterButton.Text =
            selectedNames[1] ..
            " ▼"
    else
        FilterButton.Text =
            tostring(#selectedNames) ..
            " eggs selected ▼"
    end

    local ActiveEggs =
        getActiveEggs()

    if not ActiveEggs then
        FilterCount.Text =
            "Detected eggs: 0"

        return
    end

    local lines = {}
    local counts = {}

    for _, eggName in ipairs(
        selectedNames
    ) do
        counts[eggName] = 0
    end

    for _, egg in ipairs(
        ActiveEggs:GetChildren()
    ) do

        local eggName =
            egg:GetAttribute("Egg")

        if eggName
            and SelectedEggs[eggName] then

            counts[eggName] =
                (counts[eggName] or 0) + 1
        end
    end

    local total = 0

    for _, eggName in ipairs(
        selectedNames
    ) do

        local count =
            counts[eggName] or 0

        if count > 0 then
            total =
                total + count

            for _, egg in ipairs(
                ActiveEggs:GetChildren()
            ) do

                if egg:GetAttribute("Egg")
                    == eggName then

                    local weight =
                        tonumber(
                            egg:GetAttribute(
                                "Weight"
                            )
                        )

                    if weight then
                        table.insert(
                            lines,
                            string.format(
                                "%s - %.2f",
                                eggName,
                                weight
                            )
                        )
                    else
                        table.insert(
                            lines,
                            eggName ..
                            " - --"
                        )
                    end
                end
            end
        end
    end

    FilterCount.Text =
        "Detected eggs: " ..
        tostring(total)

    if #lines > 0 then
        FilterCount.Text =
            FilterCount.Text ..
            "\n" ..
            table.concat(
                lines,
                "\n"
            )
    end
end

