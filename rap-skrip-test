local DebugLines = { "[SYSTEM] ESP UI loaded." }
local DebugText = nil
local DebugBox = nil

local function AddDebug(message)
    table.insert(DebugLines, tostring(message))
    if #DebugLines > 150 then
        table.remove(DebugLines, 1)
    end

    if DebugText then
        DebugText.Text = table.concat(DebugLines, "\n")
    end

    if DebugText and DebugBox then
        task.defer(function()
            if DebugText and DebugBox then
                DebugBox.CanvasSize = UDim2.fromOffset(0, DebugText.AbsoluteSize.Y + 15)
                DebugBox.CanvasPosition = Vector2.new(0, math.max(0, DebugText.AbsoluteSize.Y - DebugBox.AbsoluteSize.Y))
            end
        end)
    end
end

local function safeFindChild(parent, childName)
    if not parent then
        return nil
    end

    local child = parent:FindFirstChild(childName)
    if child then
        return child
    end

    return nil
end

local function safeWaitForChild(parent, childName, timeout)
    if not parent then
        return nil
    end

    local child = safeFindChild(parent, childName)
    if child then
        return child
    end

    local ok, result = pcall(function()
        return parent:WaitForChild(childName, timeout or 5)
    end)

    if ok then
        return result
    end

    return nil
end

local function safeRemotePath(parent, names)
    if not parent then
        return nil
    end

    for _, name in ipairs(names) do
        local found = safeFindChild(parent, name)
        if found then
            return found
        end
    end

    return nil
end

