ESPButton.MouseButton1Click:Connect(function() showPage(ESPPage) end)
DebugButton.MouseButton1Click:Connect(function() showPage(DebugPage) end)
SettingsButton.MouseButton1Click:Connect(function() showPage(SettingsPage) end)
Close.MouseButton1Click:Connect(function() Main.Visible = false Minimized.Visible = true end)
Minimized.MouseButton1Click:Connect(function() Main.Visible = true Minimized.Visible = false end)

local lastAutoError = ""
local lastAutoErrorTime = 0

task.spawn(function()
    while Gui.Parent do
        if Toggle.Text == "ON" then pcall(updateESP) end
        task.wait(1)
    end
end)

task.spawn(function()
    while Gui.Parent do
        if AutoPickupRunning and not AutoPickupBusy then
            local success, err = pcall(tryAutoPickup)
            if not success then
                local errorText = tostring(err)
                local now = os.clock()
                if errorText ~= lastAutoError or now - lastAutoErrorTime >= 5 then
                    AddDebug("[AUTO ERROR] " .. errorText)
                    lastAutoError = errorText
                    lastAutoErrorTime = now
                end
                AutoPickupBusy = false
                task.wait(1)
            end
        end
        task.wait(0.25)
    end
end)

