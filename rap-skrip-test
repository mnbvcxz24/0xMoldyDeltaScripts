function saveConfig()
    if not writefile then return end
    pcall(function()
        if makefolder and isfolder and not isfolder(CONFIG_FOLDER) then makefolder(CONFIG_FOLDER) end
        local selected = {}
        for eggName in pairs(SelectedEggs) do table.insert(selected, eggName) end
        table.sort(selected)
        local autoSelected = {}
        for eggName in pairs(AutoSelectedEggs) do table.insert(autoSelected, eggName) end
        table.sort(autoSelected)
        writefile(CONFIG_FILE, HttpService:JSONEncode({selectedEggs = selected, autoSelectedEggs = autoSelected, claimDelay = AutoPickupClaimDelay}))
    end)
end

function loadConfig()
    if not isfile or not readfile then return end
    local exists = false
    pcall(function() exists = isfile(CONFIG_FILE) end)
    if not exists then return end
    local success, data = pcall(function() return HttpService:JSONDecode(readfile(CONFIG_FILE)) end)
    if not success or type(data) ~= "table" then return end
    SelectedEggs = {}
    AutoSelectedEggs = {}
    if type(data.selectedEggs) == "table" then
        for _, eggName in ipairs(data.selectedEggs) do if type(eggName) == "string" and eggName ~= "--" then SelectedEggs[eggName] = true end end
    end
    if type(data.autoSelectedEggs) == "table" then
        for _, eggName in ipairs(data.autoSelectedEggs) do if type(eggName) == "string" and eggName ~= "--" then AutoSelectedEggs[eggName] = true end end
    end
    if tonumber(data.claimDelay) then AutoPickupClaimDelay = math.clamp(tonumber(data.claimDelay), 1, 5) end
end

local function getRanchLuckText()
    local playerGui = player:FindFirstChild("PlayerGui")
    local upgrade = playerGui and playerGui:FindFirstChild("Upgrade")
    local currentUpgrade = upgrade and upgrade:FindFirstChild("CurrentUpgrade")
    return currentUpgrade and currentUpgrade.Text or nil
end

local function parseLuck(value)
    if not value then return nil end
    value = tostring(value):upper():gsub(",", ""):gsub("%s+", ""):gsub("X", "")
    local number, suffix = value:match("^([%d%.]+)([KMBT]?)$")
    number = tonumber(number)
    if not number then return nil end
    local multipliers = {K = 1000, M = 1000000, B = 1000000000, T = 1000000000000}
    return number * (multipliers[suffix] or 1)
end

local function getRanchLuck()
    return parseLuck(getRanchLuckText())
end

local function getEggLuckText(eggName)
    if not eggName or eggName == "--" then return nil end
    local playerGui = player:FindFirstChild("PlayerGui")
    local main = playerGui and playerGui:FindFirstChild("Main")
    local eggTracker = main and main:FindFirstChild("EggTracker")
    local eggsHolder = eggTracker and eggTracker:FindFirstChild("EggsHolder")
    local eggFrame = eggsHolder and eggsHolder:FindFirstChild(eggName)
    local luckDisplay = eggFrame and eggFrame:FindFirstChild("LuckDisplay")
    local luck = luckDisplay and luckDisplay:FindFirstChild("Luck")
    return luck and luck.Text or nil
end

local function getEggLuck(eggName)
    return parseLuck(getEggLuckText(eggName))
end

local function calculateKG(weight, eggLuck, ranchLuck)
    weight = tonumber(weight)
    eggLuck = tonumber(eggLuck)
    ranchLuck = tonumber(ranchLuck)
    if not weight or not eggLuck or not ranchLuck then return nil end
    return weight * ((eggLuck * ranchLuck) ^ (1 / 3)) * 0.1272
end

