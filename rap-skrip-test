local dragging = false
local dragStart
local startPos

Header.InputBegan:Connect(function(input)
    if input.UserInputType ==
        Enum.UserInputType.MouseButton1
        or input.UserInputType ==
        Enum.UserInputType.Touch then

        dragging = true

        dragStart =
            input.Position

        startPos =
            Main.Position

        input.Changed:Connect(
            function()

                if input.UserInputState ==
                    Enum.UserInputState.End then

                    dragging = false
                end
            end
        )
    end
end)

local minimizedDragging = false
local minimizedDragStart
local minimizedStartPos

Minimized.InputBegan:Connect(function(input)
    if input.UserInputType ==
        Enum.UserInputType.MouseButton1
        or input.UserInputType ==
        Enum.UserInputType.Touch then

        minimizedDragging = true

        minimizedDragStart =
            input.Position

        minimizedStartPos =
            Minimized.Position

        input.Changed:Connect(
            function()

                if input.UserInputState ==
                    Enum.UserInputState.End then

                    minimizedDragging = false
                end
            end
        )
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if minimizedDragging
        and (
            input.UserInputType ==
                Enum.UserInputType.MouseMovement
            or input.UserInputType ==
                Enum.UserInputType.Touch
        ) then

        local delta =
            input.Position -
            minimizedDragStart

        Minimized.Position =
            UDim2.new(
                minimizedStartPos.X.Scale,
                minimizedStartPos.X.Offset +
                    delta.X,
                minimizedStartPos.Y.Scale,
                minimizedStartPos.Y.Offset +
                    delta.Y
            )
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging
        and (
            input.UserInputType ==
                Enum.UserInputType.MouseMovement
            or input.UserInputType ==
                Enum.UserInputType.Touch
        ) then

        local delta =
            input.Position -
            dragStart

        Main.Position =
            UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset +
                    delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset +
                    delta.Y
            )
    end
end)

local function showPage(page)
    AutoPage.Visible = false
    ESPPage.Visible = false
    DebugPage.Visible = false
    SettingsPage.Visible = false

    page.Visible = true

    FilterFrame.Visible = false
    AutoFilterFrame.Visible = false
end

