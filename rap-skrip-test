local function AddDebug(message)
    table.insert(DebugLines, tostring(message))
    if #DebugLines > 150 then table.remove(DebugLines, 1) end
    if DebugText then
        DebugText.Text = table.concat(DebugLines, "\n")
        task.defer(function()
            if DebugText and DebugBox then
                DebugBox.CanvasSize = UDim2.fromOffset(0, DebugText.AbsoluteSize.Y + 15)
                DebugBox.CanvasPosition = Vector2.new(0, math.max(0, DebugText.AbsoluteSize.Y - DebugBox.AbsoluteSize.Y))
            end
        end)
    end
end

local function formatKG(kg)
    kg = tonumber(kg)
    if not kg then return "--" end
    if kg >= 1000000000000 then return string.format("%.2fT KG", kg / 1000000000000) end
    if kg >= 1000000000 then return string.format("%.2fB KG", kg / 1000000000) end
    if kg >= 1000000 then return string.format("%.2fM KG", kg / 1000000) end
    if kg >= 1000 then return string.format("%.2fK KG", kg / 1000) end
    return string.format("%.2f KG", kg)
end

