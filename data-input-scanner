local function splitPath(path)
    local parts = {}

    path = tostring(path or "")
    path = string.gsub(path, "^%s+", "")
    path = string.gsub(path, "%s+$", "")
    path = string.gsub(path, "^game%.", "")

    for part in string.gmatch(path, "[^%.]+") do
        table.insert(parts, part)
    end

    return parts
end

local function getRoot(path)
    local parts = splitPath(path)

    if #parts == 0 then
        return nil, nil
    end

    local current
    local first = parts[1]

    if first == "Players" then
        current = game:GetService("Players")
        table.remove(parts, 1)

        if parts[1] == "LocalPlayer" then
            current = player
            table.remove(parts, 1)
        end

    elseif first == "PlayerGui" then
        current = player:FindFirstChild("PlayerGui")
        table.remove(parts, 1)

    elseif first == "CoreGui" then
        current = CoreGui
        table.remove(parts, 1)

    elseif first == "ReplicatedStorage" then
        current = game:GetService("ReplicatedStorage")
        table.remove(parts, 1)

    elseif first == "Workspace" or first == "workspace" then
        current = workspace
        table.remove(parts, 1)

    elseif first == "Lighting" then
        current = game:GetService("Lighting")
        table.remove(parts, 1)

    elseif first == "ReplicatedFirst" then
        current = game:GetService("ReplicatedFirst")
        table.remove(parts, 1)

    elseif first == "StarterGui" then
        current = game:GetService("StarterGui")
        table.remove(parts, 1)

    elseif first == "StarterPlayer" then
        current = game:GetService("StarterPlayer")
        table.remove(parts, 1)

    elseif first == "Main" then
        local playerGui = player:FindFirstChild("PlayerGui")

        if not playerGui then
            return nil, "PlayerGui not found."
        end

        current = playerGui:FindFirstChild("Main", true)
        table.remove(parts, 1)

    else
        current = game:FindFirstChild(first)

        if not current then
            local playerGui = player:FindFirstChild("PlayerGui")

            if playerGui then
                current = playerGui:FindFirstChild(first, true)
            end
        end

        if not current then
            return nil, "Could not find root: " .. first
        end

        table.remove(parts, 1)
    end

    if not current then
        return nil, "Root object not found."
    end

    for _, part in ipairs(parts) do
        local nextObject = current:FindFirstChild(part)

        if not nextObject then
            nextObject = current:FindFirstChild(part, true)
        end

        if not nextObject then
            return nil, "Could not find: " .. part
        end

        current = nextObject
    end

    return current
end

local function getSearchRoots()
    return {
        game:GetService("Players"),
        game:GetService("ReplicatedStorage"),
        game:GetService("ReplicatedFirst"),
        game:GetService("Lighting"),
        game:GetService("StarterGui"),
        game:GetService("StarterPlayer"),
        workspace,
        CoreGui
    }
end

local function getObjectValues(object)
    local values = {}

    if object:IsA("TextLabel")
        or object:IsA("TextButton")
        or object:IsA("TextBox") then

        table.insert(
            values,
            "Text = " .. tostring(object.Text)
        )
    end

    if object:IsA("ValueBase") then
        table.insert(
            values,
            "Value = " .. tostring(object.Value)
        )
    end

    local attributes = object:GetAttributes()

    for name, value in pairs(attributes) do
        table.insert(
            values,
            "Attribute ["
            .. tostring(name)
            .. "] = "
            .. tostring(value)
        )
    end

    return values
end

local function objectMatches(object, search)
    if search == "" then
        return true
    end

    local name = string.lower(object.Name)

    if string.find(name, search, 1, true) then
        return true
    end

    for _, value in ipairs(getObjectValues(object)) do
        if string.find(
            string.lower(value),
            search,
            1,
            true
        ) then
            return true
        end
    end

    return false
end

local function addObjectInfo(lines, object)
    table.insert(
        lines,
        "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    )

    table.insert(
        lines,
        "Name: " .. object.Name
    )

    table.insert(
        lines,
        "Class: " .. object.ClassName
    )

    table.insert(
        lines,
        "Path: " .. object:GetFullName()
    )

    local values = getObjectValues(object)

    if #values > 0 then
        table.insert(lines, "")

        for _, value in ipairs(values) do
            table.insert(lines, value)
        end
    end

    local children = object:GetChildren()

    if #children > 0 then
        table.insert(lines, "")
        table.insert(
            lines,
            "Children: " .. tostring(#children)
        )

        for _, child in ipairs(children) do
            local childValues = getObjectValues(child)
            local childValue = ""

            if #childValues > 0 then
                childValue =
                    " | "
                    .. table.concat(
                        childValues,
                        " | "
                    )
            end

            table.insert(
                lines,
                "  └─ "
                .. child.Name
                .. " ["
                .. child.ClassName
                .. "]"
                .. childValue
            )
        end
    end

    table.insert(lines, "")
end

local function scan()
    scanButton.Text = "Scanning..."

    local path = tostring(pathBox.Text or "")
    local search = string.lower(
        tostring(valueBox.Text or "")
    )

    path = string.gsub(path, "^%s+", "")
    path = string.gsub(path, "%s+$", "")

    if path == "" and search == "" then
        status.Text =
            "DATA SCANNER\n\n"
            .. "Please enter either:\n\n"
            .. "• A Path\n"
            .. "• A Search Value\n"
            .. "• Or both"

        task.wait()

        local height = status.TextBounds.Y + 20

        status.Size = UDim2.new(
            1,
            0,
            0,
            height
        )

        scroll.CanvasSize = UDim2.new(
            0,
            0,
            0,
            height + 40
        )

        scanButton.Text = "Scan"
        return
    end

    local root
    local errorMessage

    if path ~= "" then
        root, errorMessage = getRoot(path)

        if not root then
            status.Text =
                "SCAN FAILED\n\n"
                .. tostring(errorMessage)

            task.wait()

            local height = status.TextBounds.Y + 20

            status.Size = UDim2.new(
                1,
                0,
                0,
                height
            )

            scroll.CanvasSize = UDim2.new(
                0,
                0,
                0,
                height + 40
            )

            scanButton.Text = "Scan"
            return
        end
    end

    local lines = {}

    table.insert(
        lines,
        "DATA SCANNER"
    )

    table.insert(
        lines,
        "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    )

    if root then
        table.insert(
            lines,
            "Root: " .. root:GetFullName()
        )
    else
        table.insert(
            lines,
            "Root: GLOBAL SEARCH"
        )
    end

    table.insert(
        lines,
        "Search: "
        .. (
            search ~= ""
            and valueBox.Text
            or "ALL"
        )
    )

    table.insert(lines, "")

    local found = 0
    local scanned = {}

    local function processObject(object)
        if scanned[object] then
            return
        end

        scanned[object] = true

        if objectMatches(object, search) then
            found += 1
            addObjectInfo(lines, object)
        end
    end

    if root then
        processObject(root)

        for _, object in ipairs(root:GetDescendants()) do
            processObject(object)
        end
    else
        for _, searchRoot in ipairs(getSearchRoots()) do
            processObject(searchRoot)

            for _, object in ipairs(
                searchRoot:GetDescendants()
            ) do
                processObject(object)
            end
        end
    end

    if found == 0 then
        table.insert(
            lines,
            "No matching objects found."
        )
    else
        table.insert(
            lines,
            "Results: " .. tostring(found)
        )
    end

    table.insert(lines, "")

    table.insert(
        lines,
        "Updated: " .. os.date("%H:%M:%S")
    )

    status.Text = table.concat(
        lines,
        "\n"
    )

    task.wait()

    local height = math.max(
        status.TextBounds.Y + 20,
        100
    )

    status.Size = UDim2.new(
        1,
        0,
        0,
        height
    )

    scroll.CanvasSize = UDim2.new(
        0,
        0,
        0,
        height + 20
    )

    scroll.CanvasPosition = Vector2.new(0, 0)

    scanButton.Text = "Scan"
end

scanButton.MouseButton1Click:Connect(function()
    task.spawn(scan)
end)

