local function row(parent, y, label, data, showRole, roleKey)
    roleKey = roleKey or "roles"
    local toggle = Instance.new("TextButton", parent)
    toggle.Size = UDim2.new(0, 105, 0, 28)
    toggle.Position = UDim2.new(0, 12, 0, y)
    toggle.BackgroundColor3 = Color3.fromRGB(45, 45, 52)
    toggle.BorderSizePixel = 0
    toggle.Text = ""
    toggle.Font = Enum.Font.GothamMedium
    toggle.TextSize = 10
    toggle.TextColor3 = Color3.new(1, 1, 1)
    Instance.new("UICorner", toggle).CornerRadius = UDim.new(0, 7)

    local role

    if showRole ~= false then
        role = Instance.new("TextBox", parent)
        role.Size = UDim2.new(1, -135, 0, 28)
        role.Position = UDim2.new(0, 125, 0, y)
        role.BackgroundColor3 = Color3.fromRGB(22, 22, 27)
        role.BorderSizePixel = 0
        role.Font = Enum.Font.Gotham
        role.TextSize = 10
        role.TextColor3 = Color3.new(1, 1, 1)
        role.Text = data[roleKey] or ""
        role.PlaceholderText = "role IDs"
        role.ClearTextOnFocus = false

        role.FocusLost:Connect(function()
            data[roleKey] = role.Text
            saveConfig()
        end)
    end

    local function refresh()
        toggle.Text = (data.enabled and "✓ " or "○ ") .. label
    end

    refresh()

    toggle.MouseButton1Click:Connect(function()
        data.enabled = not data.enabled
        refresh()
        saveConfig()
    end)

    return toggle, role
end
    
