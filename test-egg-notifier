local function split(value)
    local result = {}
    for part in string.gmatch(tostring(value or ""), "[^,]+") do
        local s = string.match(part, "^%s*(.-)%s*$")
        if s ~= "" then
            table.insert(result, s)
        end
    end
    return result
end

