local function sendEggHistoryWebhook(webhook, body, method, messageId)
    local requestFunction =
        (syn and syn.request)
        or (http and http.request)
        or http_request
        or request

    if not requestFunction then
        return false, nil
    end

    local url = webhook

    if method == "PATCH" then
        local webhookId, webhookToken =
            string.match(
                webhook,
                "^https://discord%.com/api/webhooks/(%d+)/([^%?]+)"
            )

        if not webhookId or not webhookToken or not messageId then
            return false, nil
        end

        url =
            "https://discord.com/api/webhooks/"
            .. webhookId
            .. "/"
            .. webhookToken
            .. "/messages/"
            .. tostring(messageId)
    else
        url = webhook .. "?wait=true"
    end

    local success, response = pcall(function()
        return requestFunction({
            Url = url,
            Method = method or "POST",
            Headers = {
                ["Content-Type"] = "application/json"
            },
            Body = game:GetService("HttpService"):JSONEncode(body)
        })
    end)

    if not success or not response then
        return false, nil
    end

    local statusCode = response.StatusCode

    if statusCode and (statusCode < 200 or statusCode >= 300) then
        return false, response
    end

    local responseData

    if response.Body then
        pcall(function()
            responseData =
                game:GetService("HttpService"):JSONDecode(response.Body)
        end)
    end

    return true, responseData
end

