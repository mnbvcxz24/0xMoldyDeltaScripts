local function loadConfig()
    ensureConfigFolder()

    if not isfile(CONFIG_FILE) then
        return defaultConfig()
    end

    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(CONFIG_FILE))
    end)

    if not ok or type(data) ~= "table" then
        return defaultConfig()
    end

    data.monitoring = data.monitoring == true
    data.antiAfk = data.antiAfk == true
    data.discordEgg = type(data.discordEgg) == "table" and data.discordEgg or {}
    data.discordEgg.webhook = tostring(data.discordEgg.webhook or "")
    data.discordEgg.eggs = type(data.discordEgg.eggs) == "table" and data.discordEgg.eggs or {}

    data.discordWeather = type(data.discordWeather) == "table" and data.discordWeather or {}
    data.discordWeather.webhook = tostring(data.discordWeather.webhook or "")
    data.discordWeather.weathers = type(data.discordWeather.weathers) == "table" and data.discordWeather.weathers or {}

    data.eggHistory = type(data.eggHistory) == "table" and data.eggHistory or {}
    data.eggHistory.webhook = tostring(data.eggHistory.webhook or "")
    data.eggHistory.eggs = type(data.eggHistory.eggs) == "table" and data.eggHistory.eggs or {}
    
    data.weatherHistory = type(data.weatherHistory) == "table" and data.weatherHistory or {}
    data.weatherHistory.webhook = tostring(data.weatherHistory.webhook or "")
    data.weatherHistory.weathers = type(data.weatherHistory.weathers) == "table" and data.weatherHistory.weathers or {}

    data.gearStock = type(data.gearStock) == "table" and data.gearStock or {}
    data.gearStock.webhook = tostring(data.gearStock.webhook or "")
    data.gearStock.gears = type(data.gearStock.gears) == "table" and data.gearStock.gears or {}
    
    return data
end

