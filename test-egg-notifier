local function requestPost(url,payload)
    local fn=(syn and syn.request) or (http and http.request) or http_request or request
    if not fn then return false end
    return pcall(function() fn({Url=url,Method="POST",Headers={['Content-Type']='application/json'},Body=HttpService:JSONEncode(payload)}) end)
end
local function split(value)
    local t={}; for part in string.gmatch(tostring(value or ""),"[^,]+") do local s=string.match(part,"^%s*(.-)%s*$"); if s~="" then table.insert(t,s) end end; return t
end
local function getWebhookList(text) return split(text) end
local function getRoleList(text) return split(text) end

local function getEggResetTime()
    local v=ServerData:FindFirstChild("LastEggResetTime")
    if v and v:IsA("NumberValue") and v.Value>0 then return v.Value end
    v=ServerData:FindFirstChild("LastRestockTime")
    if v and v:IsA("NumberValue") and v.Value>0 then return v.Value+420 end
    return nil
end

local function getActiveWeathers()
    local value=ServerData:GetAttribute("ActiveWeathers")
    if not value or value=="" then return {} end
    if type(value)=="string" then local ok,data=pcall(function() return HttpService:JSONDecode(value) end); if ok and type(data)=="table" then return data end end
    return {}
end
local function weatherInfo(w)
    if type(w)=="string" then return {name=w} end
    if type(w)~="table" then return nil end
    local name=w.Name or w.Weather or w.Variant or w.Type or w.Id
    local endsAt=tonumber(w.EndsAt) or tonumber(w.EndTime) or tonumber(w.ExpiresAt)
    if not name then return nil end
    return {name=tostring(name),endsAt=endsAt}
end

local function sendDiscordEgg(eggName,stock,spawnTime)
    local ec=config.discordEgg.eggs[eggName]
    if not ec or not ec.enabled then return end
    local webhooks=getWebhookList(discordEggInput.Text); if #webhooks==0 then return end
    local roles=getRoleList(ec.roles)
    local reset=getEggResetTime()
    local fields={{name="📦 Stock",value=tostring(stock),inline=false},{name="🕐 Stock Time",value="<t:"..math.floor(spawnTime)..":t>",inline=true}}
    if reset then table.insert(fields,{name="🔄 Reset Time",value="<t:"..math.floor(reset)..":t>",inline=true}); table.insert(fields,{name="⏳ Resets",value="<t:"..math.floor(reset)..":R>",inline=false}) end
    local embed={title=(eggEmojis[eggName] or "🥚").." "..string.upper(eggName).." SPAWNED!",color=eggEmbedColors[eggName] or 0x5865F2,fields=fields,footer={text="Ride a Pet • Egg Stock Notifier"}}
    if eggThumbnails[eggName] then embed.thumbnail={url=eggThumbnails[eggName]} end
    for i,url in ipairs(webhooks) do requestPost(url,{content=roles[i] and ("<@&"..roles[i].."> *"..eggName.." Spawned.*") or "",embeds={embed}}) end
end

local function sendDiscordWeather(info)
    local name=info.name; local wc=config.discordWeather.weathers[name]; local m=weatherMutationInfo[name]
    if not wc or not wc.enabled or not m then return end
    local webhooks=getWebhookList(discordWeatherInput.Text); if #webhooks==0 then return end
    local roles=getRoleList(wc.roles); local start=os.time(); local ends=info.endsAt or (start+300)
    local embed={title=m.emoji.." "..string.upper(name).." WEATHER!",color=weatherEmbedColors[name] or 0x5865F2,fields={{name="💰 Cash",value=m.cash,inline=true},{name="⚡ Speed",value=m.speed,inline=true},{name="🕐 Start Time",value="<t:"..start..":t>",inline=true},{name="🔄 End Time",value="<t:"..math.floor(ends)..":t>",inline=true},{name="⏳ Ends",value="<t:"..math.floor(ends)..":R>",inline=false}},footer={text="Ride a Pet • Weather Notifier"}}
    if weatherThumbnails[name] then embed.thumbnail={url=weatherThumbnails[name]} end
    for i,url in ipairs(webhooks) do requestPost(url,{content=roles[i] and ("<@&"..roles[i].."> *"..name.." Started.*") or "",embeds={embed}}) end
end

