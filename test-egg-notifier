local function enableAutoExecute()
    if type(writefile) == "function" then
        writefile(AUTOEXECUTE_FILE, AUTOEXECUTE_CONTENT)
        return true
    end
    return false
end

local function disableAutoExecute()
    if type(isfile) == "function" and type(delfile) == "function" then
        if isfile(AUTOEXECUTE_FILE) then
            delfile(AUTOEXECUTE_FILE)
        end
        return true
    end
    return false
end

local function saveConfig()
    if not canUseFileStorage() then
        return false
    end

    local config = {
        webhooks = {},
        eggs = {},
        weather = {},
        eggHistory = {
            webhook = eggHistoryWebhookInput and eggHistoryWebhookInput.Text or "",
            eggs = {}
        }
    }
    for eggName, toggle in pairs(eggHistoryToggles) do
        config.eggHistory.eggs[eggName] =
            toggle:GetAttribute("Enabled") == true
    end
    for index = 1, 3 do
        config.webhooks[index] =
            webhookInputs[index]
            and webhookInputs[index].Text
            or ""

        config.eggs[index] = {}

        for _, eggName in ipairs({
            "Blackhole Egg",
            "Solaris Egg",
            "Cherub Egg"
        }) do
            local toggle =
                webhookEggToggles[index]
                and webhookEggToggles[index][eggName]

            local roleInput =
                webhookRoleInputs[index]
                and webhookRoleInputs[index][eggName]

            config.eggs[index][eggName] = {
                enabled =
                    toggle
                    and toggle:GetAttribute("Enabled") == true
                    or false,

                roles =
                    roleInput
                    and roleInput.Text
                    or ""
            }
        end

        config.weather[index] = {}

for _, weatherName in ipairs({
    "Thunder",
    "Volt",
    "Raging",
    "Dreadful",
    "Eternal"
}) do
    local toggle =
        webhookWeatherToggles[index]
        and webhookWeatherToggles[index][weatherName]

    local roleInput =
        webhookWeatherRoleInputs[index]
        and webhookWeatherRoleInputs[index][weatherName]

    config.weather[index][weatherName] = {
        enabled =
            toggle
            and toggle:GetAttribute("Enabled") == true
            or false,

        roles =
            roleInput
            and roleInput.Text
            or ""
    }
end
    end

    local encodeSuccess, encoded = pcall(function()
        return HttpService:JSONEncode(config)
    end)

    if not encodeSuccess then
        return false
    end

    local writeSuccess = pcall(function()
        writefile(CONFIG_FILE, encoded)
    end)

    return writeSuccess
end

