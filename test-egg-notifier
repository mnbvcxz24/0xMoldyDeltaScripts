local function ensureConfigFolder()
    if not isfolder(CONFIG_FOLDER) then makefolder(CONFIG_FOLDER) end
end

local function defaultConfig()
    return {
        monitoring = false,
        discordEgg = { webhook = "", eggs = {} },
        discordWeather = { webhook = "", weathers = {} }
    }
end

local function loadConfig()
    ensureConfigFolder()
    if not isfile(CONFIG_FILE) then return defaultConfig() end
    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(CONFIG_FILE)) end)
    if not ok or type(data) ~= "table" then return defaultConfig() end
    data.monitoring = data.monitoring == true
    data.discordEgg = type(data.discordEgg) == "table" and data.discordEgg or {}
    data.discordEgg.webhook = tostring(data.discordEgg.webhook or "")
    data.discordEgg.eggs = type(data.discordEgg.eggs) == "table" and data.discordEgg.eggs or {}
    data.discordWeather = type(data.discordWeather) == "table" and data.discordWeather or {}
    data.discordWeather.webhook = tostring(data.discordWeather.webhook or "")
    data.discordWeather.weathers = type(data.discordWeather.weathers) == "table" and data.discordWeather.weathers or {}
    return data
end

