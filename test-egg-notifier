local function updateEggsInWorld()
    local eggCounts = {}
    local totalEggs = 0

    for _, egg in ipairs(ActiveEggs:GetChildren()) do
        local eggName = egg:GetAttribute("Egg")

        if eggName then
            eggCounts[eggName] = (eggCounts[eggName] or 0) + 1
            totalEggs += 1
        end
    end

    local eggNames = {}

    for eggName in pairs(eggCounts) do
        table.insert(eggNames, eggName)
    end

    table.sort(eggNames)

    local lines = {
        "Total Eggs: " .. totalEggs,
        ""
    }

    for _, eggName in ipairs(eggNames) do
        table.insert(lines, eggName .. " - " .. eggCounts[eggName])
    end

    if totalEggs == 0 then
        eggsStatus.Text = "No eggs found"
    else
        eggsStatus.Text = table.concat(lines, "\n")
    end
end

