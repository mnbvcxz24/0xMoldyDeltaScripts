local function getActiveWeathers()
    local activeWeathers = ServerData:GetAttribute("ActiveWeathers")

    if not activeWeathers or activeWeathers == "" then
        return {}
    end

    if type(activeWeathers) == "string" then
        local success, decoded = pcall(function()
            return HttpService:JSONDecode(activeWeathers)
        end)

        if success and type(decoded) == "table" then
            return decoded
        end
    end

    return {}
end

local function getWeatherName(weather)
    if type(weather) == "string" then
        return weather
    end

    if type(weather) == "table" then
        return weather.Name
            or weather.Weather
            or weather.Variant
            or weather.Type
            or weather.Id
            or "Unknown Weather"
    end

    return "Unknown Weather"
end

local function updateCurrentWeather()
    local activeWeathers = getActiveWeathers()

    if #activeWeathers == 0 then
        weatherStatus.Text = "No weather detected"
        return
    end

    local weatherNames = {}

    for _, weather in ipairs(activeWeathers) do
        table.insert(weatherNames, getWeatherName(weather))
    end

    weatherStatus.Text = table.concat(weatherNames, "\n")
end

updateCurrentWeather()

ServerData:GetAttributeChangedSignal("ActiveWeathers"):Connect(function()
    updateCurrentWeather()
end)

