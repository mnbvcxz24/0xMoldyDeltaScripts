    local names={}; local current={}
    for _,w in ipairs(getActiveWeathers()) do local info=weatherInfo(w); if info and weatherMutationInfo[info.name] then current[info.name]=info; table.insert(names,weatherMutationInfo[info.name].emoji.." "..info.name) end end
    weatherStatus.Text=#names>0 and table.concat(names,"\n") or "No weather detected"
    local nextKnown={}
    for _,info in pairs(current) do local key=weatherKey(info); nextKnown[key]=true; if monitoringRunning and not knownWeather[key] then sendDiscordWeather(info) end end
    knownWeather=nextKnown
end
ServerData:GetAttributeChangedSignal("ActiveWeathers"):Connect(updateWeather)

local function updateEggs()
    local counts={}; local total=0
    for _,egg in ipairs(ActiveEggs:GetChildren()) do local n=egg:GetAttribute("Egg"); if n then counts[n]=(counts[n] or 0)+1; total+=1 end end
    local names={}; for n in pairs(counts) do table.insert(names,n) end; table.sort(names)
    local lines={"Total Eggs: "..total,""}; for _,n in ipairs(names) do table.insert(lines,n.." - "..counts[n]) end
    eggsStatus.Text=total==0 and "No eggs found" or table.concat(lines,"\n")
end
ActiveEggs.ChildAdded:Connect(updateEggs); ActiveEggs.ChildRemoved:Connect(updateEggs)

local function updateStatus()
    local egg=discordEggInput.Text~=""; local weather=discordWeatherInput.Text~=""
    webhookStatus.Text=(egg or weather) and "Configured" or "Not Connected"
    local e=false; for _,n in ipairs(eggList) do if config.discordEgg.eggs[n].enabled then e=true break end end
    local w=false; for _,n in ipairs(weatherList) do if config.discordWeather.weathers[n].enabled then w=true break end end
    discordEggStatus.Text=e and "Enabled" or "Disabled"; discordWeatherStatus.Text=w and "Enabled" or "Disabled"
end

discordEggInput.FocusLost:Connect(function() config.discordEgg.webhook=discordEggInput.Text; saveConfig(); updateStatus() end)
discordWeatherInput.FocusLost:Connect(function() config.discordWeather.webhook=discordWeatherInput.Text; saveConfig(); updateStatus() end)

