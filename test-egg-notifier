            current[info.name] = info
            table.insert(names, weatherMutationInfo[info.name].emoji .. " " .. info.name)
        end
    end

    weatherStatus.Text = #names > 0 and table.concat(names, "\n") or "No weather detected"

    local nextKnown = {}
    for _, info in pairs(current) do
        local key = weatherKey(info)
        nextKnown[key] = true

        if monitoringRunning and not knownWeather[key] then
            sendDiscordWeather(info)
            sendWeatherHistoryWebhook(info.name, info.endsAt)
        end
    end

    knownWeather = nextKnown
end

