local function sendWeatherHistoryWebhook(weatherName, endsAt)
    local data = config.weatherHistory.weathers[weatherName]

    if type(data) ~= "table" or not data.enabled then
        return
    end

    local webhooks = getWebhookList(config.weatherHistory.webhook)

    if #webhooks == 0 then
        return
    end

    local history = getWeatherHistory(weatherName)

    table.insert(history.entries, {
        spawnTime = os.time(),
        endsAt = tonumber(endsAt)
    })

    if type(history.messageIds) ~= "table" then
        history.messageIds = {}
    end

    local payload = buildWeatherHistoryPayload(weatherName, history)

    for _, webhook in ipairs(webhooks) do
        local messageId = history.messageIds[webhook]
        local success
        local response

        if messageId then
            success = sendHistoryWebhook(
                webhook,
                payload,
                "PATCH",
                messageId
            )

            if not success then
                history.messageIds[webhook] = nil
            end
        end

        if not history.messageIds[webhook] then
            success, response = sendHistoryWebhook(
                webhook,
                payload,
                "POST"
            )

            if success and response and response.id then
                history.messageIds[webhook] = response.id
            end
        end
    end

    saveWeatherSpawnHistory()
end

