local function sendDiscordEgg(eggName, stock)
    if not monitoringRunning then
        return
    end

    if not config.discordEgg.enabled then
        return
    end

    local webhook = config.discordEgg.webhook

    if webhook == "" then
        return
    end

    local body = {
        content =
            "🥚 **" .. tostring(eggName) .. " spawned!**\n" ..
            "Stock: " .. tostring(stock)
    }

    pcall(function()
        request({
            Url = webhook,
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json"
            },
            Body = HttpService:JSONEncode(body)
        })
    end)
end

local knownEggs = {}

for _, egg in ipairs(ActiveEggs:GetChildren()) do
    knownEggs[egg] = true
end

ActiveEggs.ChildAdded:Connect(function(egg)
    if knownEggs[egg] then
        return
    end

    knownEggs[egg] = true

    task.wait(0.1)

    if not monitoringRunning then
        return
    end

    local eggName = egg:GetAttribute("Egg")

    if not eggName then
        return
    end

    local stock = 0

    for _, activeEgg in ipairs(ActiveEggs:GetChildren()) do
        if activeEgg:GetAttribute("Egg") == eggName then
            stock += 1
        end
    end

    sendDiscordEgg(eggName, stock)
end)

ActiveEggs.ChildRemoved:Connect(function(egg)
    knownEggs[egg] = nil
end)

local function loadConfig()
    ensureConfigFolder()

    if not isfile(CONFIG_FILE) then
        return {
            monitoring = false,
            discordEgg = {
                enabled = false,
                webhook = ""
            }
        }
    end

    local success, data = pcall(function()
        return HttpService:JSONDecode(readfile(CONFIG_FILE))
    end)

    if success and type(data) == "table" then
        if data.monitoring == nil then
            data.monitoring = false
        end

        if type(data.discordEgg) ~= "table" then
            data.discordEgg = {
                enabled = false,
                webhook = ""
            }
        end

        return data
    end

    return {
        monitoring = false,
        discordEgg = {
            enabled = false,
            webhook = ""
        }
    }
end

