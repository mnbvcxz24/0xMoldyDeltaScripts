local function startMonitoring()
    if monitoringRunning then return end
    monitoringRunning=true; monitoringEnabled=true; monitoringStatus.Text="Monitoring"; monitoringButton.Text="Stop"; saveConfig()
end
local function stopMonitoring()
    if not monitoringRunning then return end
    monitoringRunning=false; monitoringEnabled=false; monitoringStatus.Text="Stopped"; monitoringButton.Text="Start"; saveConfig()
end
