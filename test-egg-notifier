local function canUseFileStorage()
    return type(isfile) == "function"
        and type(readfile) == "function"
        and type(writefile) == "function"
end

local eggSpawnHistory = {}

local function loadEggSpawnHistory()
    if not canUseFileStorage() then
        return
    end

    if not isfile(EGG_HISTORY_FILE) then
        return
    end

    local success, data = pcall(function()
        return game:GetService("HttpService"):JSONDecode(
            readfile(EGG_HISTORY_FILE)
        )
    end)

    if success and type(data) == "table" then
        eggSpawnHistory = data
    end
end

local function saveEggSpawnHistory()
    if not canUseFileStorage() then
        return
    end

    pcall(function()
        writefile(
            EGG_HISTORY_FILE,
            game:GetService("HttpService"):JSONEncode(
                eggSpawnHistory
            )
        )
    end)
end

local function getHistoryDate()
    return os.date("%Y-%m-%d")
end

local function getEggHistory(eggName)
    local today = getHistoryDate()

    if not eggSpawnHistory[eggName]
        or eggSpawnHistory[eggName].date ~= today then

        eggSpawnHistory[eggName] = {
            date = today,
            messageId = nil,
            entries = {}
        }
    end

    return eggSpawnHistory[eggName]
end

local function buildEggHistoryPayload(eggName, history)
    local emoji = eggEmojis[eggName]
    local color = eggEmbedColors[eggName]
    local thumbnail = eggThumbnails[eggName]

    local lines = {}

    for _, entry in ipairs(history.entries) do
        table.insert(
            lines,
            "📦 Stock " .. tostring(entry.stock)
            .. "\n"
            .. "🕐 Stock time <t:"
            .. tostring(entry.timestamp)
            .. ":t> • <t:"
            .. tostring(entry.timestamp)
            .. ":R>"
        )
    end

    local firstTimestamp

    if history.entries[1] then
        firstTimestamp = history.entries[1].timestamp
    else
        firstTimestamp = os.time()
    end

    local description =
        "📅 <t:"
        .. tostring(firstTimestamp)
        .. ":D>\n\n"
        .. table.concat(lines, "\n\n")

    return {
        embeds = {
            {
                title =
                    emoji
                    .. " "
                    .. string.upper(eggName)
                    .. " — SPAWN HISTORY",

                description = description,

                color = color,

                thumbnail = {
                    url = thumbnail
                },

                footer = {
                    text = "Ride a Pet • Egg Spawn History"
                }
            }
        }
    }
end

local function parseCommaSeparated(text)
    local values = {}
    text = text or ""

    local startPosition = 1

    while true do
        local commaPosition = string.find(text, ",", startPosition, true)

        if commaPosition then
            local value = string.sub(
                text,
                startPosition,
                commaPosition - 1
            )

            value = string.gsub(value, "^%s*(.-)%s*$", "%1")
            table.insert(values, value)

            startPosition = commaPosition + 1
        else
            local value = string.sub(text, startPosition)
            value = string.gsub(value, "^%s*(.-)%s*$", "%1")

            if value ~= "" or #values > 0 then
                table.insert(values, value)
            end

            break
        end
    end

    return values
end

local function getWebhooksForInput(input)
    local webhooks = {}

    if not input then
        return webhooks
    end

    for webhook in string.gmatch(input.Text or "", "([^,]+)") do
        webhook = string.gsub(webhook, "^%s*(.-)%s*$", "%1")

        if string.find(
            webhook,
            "^https://discord.com/api/webhooks/"
        ) then
            table.insert(webhooks, webhook)
        end
    end

    return webhooks
end

local function getAllConfiguredWebhooks()
    local count = 0

    for index = 1, 3 do
        count = count + #getWebhooksForInput(webhookInputs[index])
    end

    return count
end

