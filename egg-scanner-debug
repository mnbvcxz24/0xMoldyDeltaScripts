local function updateCanvas()
    task.wait()

    local height = status.TextBounds.Y + 20

    status.Size = UDim2.new(
        1,
        0,
        0,
        height
    )

    scroll.CanvasSize = UDim2.new(
        0,
        0,
        0,
        height + 16
    )
end

local function getEggsHolder()
    local playerGui = player:FindFirstChild("PlayerGui")
    if not playerGui then
        return nil
    end

    local main = playerGui:FindFirstChild("Main", true)
    if not main then
        return nil
    end

    local eggTracker = main:FindFirstChild("EggTracker", true)
    if not eggTracker then
        return nil
    end

    local eggsHolder = eggTracker:FindFirstChild("EggsHolder", true)
    if not eggsHolder then
        return nil
    end

    return eggsHolder
end

local function getEggTexts(egg)
    local texts = {}

    for _, obj in ipairs(egg:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            local text = tostring(obj.Text or "")

            if text ~= "" then
                table.insert(texts, {
                    name = obj:GetFullName(),
                    text = text
                })
            end
        end
    end

    return texts
end

local function getEggStockFromTexts(texts)
    for _, data in ipairs(texts) do
        local number = string.match(data.text, "%d+")

        if number then
            return tonumber(number), data.name, data.text
        end
    end

    return 0, nil, nil
end

local lastStock = {}

local function scanEgg(egg)
    local eggName = egg.Name
    local texts = getEggTexts(egg)

    local stock, stockObject, stockText =
        getEggStockFromTexts(texts)

    local oldStock = lastStock[eggName]

    if oldStock == nil then
        oldStock = stock
    end

    local change = "NO CHANGE"

    if stock > oldStock then
        change = "STOCK INCREASE"
    elseif stock < oldStock then
        change = "STOCK DECREASE"
    end

    if oldStock == 0 and stock > 0 then
        change = "RESTOCK"
    end

    lastStock[eggName] = stock

    return {
        name = eggName,
        stock = stock,
        oldStock = oldStock,
        change = change,
        stockObject = stockObject,
        stockText = stockText,
        texts = texts
    }
end

local function buildScan()
    local eggsHolder = getEggsHolder()

    if not eggsHolder then
        return table.concat({
            "EGG SCANNER",
            "────────────────────────────────────────",
            "",
            "EggTracker / EggsHolder not found",
            "",
            "Waiting..."
        }, "\n")
    end

    local lines = {}

    table.insert(lines, "EGG TRACKER / EGGS HOLDER")
    table.insert(lines, "────────────────────────────────────────")
    table.insert(lines, "")

    local eggs = eggsHolder:GetChildren()

    table.sort(eggs, function(a, b)
        return a.Name < b.Name
    end)

    table.insert(
        lines,
        "Eggs Found: " .. tostring(#eggs)
    )

    table.insert(lines, "")

    for _, egg in ipairs(eggs) do
        local data = scanEgg(egg)

        table.insert(
            lines,
            "🥚 " .. data.name
        )

        table.insert(
            lines,
            "  Stock: " .. tostring(data.stock)
        )

        table.insert(
            lines,
            "  Previous: " .. tostring(data.oldStock)
        )

        table.insert(
            lines,
            "  Change: " .. data.change
        )

        if data.stockObject then
            table.insert(
                lines,
                "  Stock Object: " ..
                tostring(data.stockObject)
            )
        end

        if data.stockText then
            table.insert(
                lines,
                "  Stock Text: " ..
                tostring(data.stockText)
            )
        end

        table.insert(lines, "  Text Objects:")

        for _, textData in ipairs(data.texts) do
            table.insert(
                lines,
                "    [" ..
                tostring(textData.name) ..
                "]"
            )

            table.insert(
                lines,
                "      = " ..
                tostring(textData.text)
            )
        end

        table.insert(lines, "")
    end

    table.insert(
        lines,
        "────────────────────────────────────────"
    )

    table.insert(
        lines,
        "Updated: " .. os.date("%H:%M:%S")
    )

    return table.concat(lines, "\n")
end

task.spawn(function()
    while gui.Parent do
        status.Text = buildScan()

        updateCanvas()

        task.wait(2)
    end
end)
