local eggsHolder
local eggs = {}
local lastStock = {}
local lastOutput = ""
local searchText = ""

local function getEggsHolder()
    local playerGui = player:FindFirstChild("PlayerGui")
    if not playerGui then
        return nil
    end

    local main = playerGui:FindFirstChild("Main", true)
    if not main then
        return nil
    end

    local eggTracker = main:FindFirstChild("EggTracker", true)
    if not eggTracker then
        return nil
    end

    return eggTracker:FindFirstChild("EggsHolder", true)
end

local function refreshEggList()
    eggsHolder = getEggsHolder()

    if not eggsHolder then
        eggs = {}
        return
    end

    eggs = eggsHolder:GetChildren()

    table.sort(eggs, function(a, b)
        return a.Name < b.Name
    end)
end

local function getEggData(egg)
    local stock = 0
    local stockObject = ""
    local stockText = ""
    local textObjects = {}

    for _, obj in ipairs(egg:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            local text = tostring(obj.Text or "")

            if text ~= "" then
                table.insert(
                    textObjects,
                    obj.Name .. " = " .. text
                )

                if stockObject == "" then
                    local number = string.match(text, "%d+")

                    if number then
                        stock = tonumber(number)
                        stockObject = obj.Name
                        stockText = text
                    end
                end
            end
        end
    end

    return stock, stockObject, stockText, textObjects
end

local function buildOutput()
    if not eggsHolder then
        return "EGG SCANNER\n\nEggTracker / EggsHolder not found\n\nWaiting..."
    end

    local lines = {}

    table.insert(lines, "EGG TRACKER / EGGS HOLDER")
    table.insert(lines, "────────────────────────────────────────")
    table.insert(lines, "")

    local search = string.lower(searchText)
    local found = 0

    for _, egg in ipairs(eggs) do
        if egg.Parent then
            local eggNameLower = string.lower(egg.Name)

            if search == "" or string.find(eggNameLower, search, 1, true) then
                found += 1

                local stock, stockObject, stockText, textObjects =
                    getEggData(egg)

                local oldStock = lastStock[egg.Name]

                if oldStock == nil then
                    oldStock = stock
                end

                local change = "NO CHANGE"

                if stock > oldStock then
                    change = "STOCK INCREASE"
                elseif stock < oldStock then
                    change = "STOCK DECREASE"
                end

                if oldStock == 0 and stock > 0 then
                    change = "RESTOCK"
                end

                lastStock[egg.Name] = stock

                table.insert(lines, "🥚 " .. egg.Name)
                table.insert(lines, "  Stock: " .. tostring(stock))
                table.insert(lines, "  Previous: " .. tostring(oldStock))
                table.insert(lines, "  Change: " .. change)

                if stockObject ~= "" then
                    table.insert(
                        lines,
                        "  Stock Object: " .. stockObject
                    )
                end

                if stockText ~= "" then
                    table.insert(
                        lines,
                        "  Stock Text: " .. stockText
                    )
                end

                table.insert(lines, "  Text Objects:")

                for _, text in ipairs(textObjects) do
                    table.insert(lines, "    " .. text)
                end

                table.insert(lines, "")
            end
        end
    end

    if found == 0 then
        table.insert(
            lines,
            "No eggs found for: " .. searchText
        )
    else
        table.insert(
            lines,
            "Results: " .. tostring(found)
        )
    end

    table.insert(lines, "")
    table.insert(
        lines,
        "Updated: " .. os.date("%H:%M:%S")
    )

    return table.concat(lines, "\n")
end

local function updateDisplay(text)
    if text == lastOutput then
        return
    end

    lastOutput = text
    status.Text = text

    task.wait()

    local height = status.TextBounds.Y + 20

    status.Size = UDim2.new(
        1,
        0,
        0,
        height
    )

    scroll.CanvasSize = UDim2.new(
        0,
        0,
        0,
        height + 16
    )
end

searchBox:GetPropertyChangedSignal("Text"):Connect(function()
    searchText = searchBox.Text
    lastOutput = ""
end)

task.spawn(function()
    while gui.Parent do
        refreshEggList()
        task.wait(5)
    end
end)

task.spawn(function()
    while gui.Parent do
        if #eggs == 0 then
            refreshEggList()
        end

        local output = buildOutput()
        updateDisplay(output)

        task.wait(1)
    end
end)
